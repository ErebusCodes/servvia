node_modules/
.DS_Store
**/.DS_Store
test-results/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env
.env.*
!**/.env.example
dist/
dev-dist/
coverage/
*.tsbuildinfo
.worktrees/

# One-off local debug scripts have a history of hardcoding real database
# credentials (see apps/api/db-check.js) — never track these regardless of
# name; write ad-hoc DB checks against .env-sourced config instead.
apps/api/db-check.js
*.env.bak

# Local PostgreSQL development database (disposable — recreated from Prisma
# migrations + seed data). Raw DB files must never be committed.
local-postgres/data/

# Locally uploaded media (menu images etc.) — MediaService writes here at
# runtime; never track user-uploaded content.
apps/api/storage/
*.docx
*.docx

# All video files are ignored by default — Asset/video/intro.mp4 is the one
# master copy we track, and the symlink that points to it (instead of a
# separate per-app copy) is explicitly allowed through below.
*.mp4
!Asset/video/intro.mp4
!apps/web/customer-website/public/video/intro.mp4

AUDIT_REPORT.md
AUDIT_REPORT_V2.md

# Nested live PostgreSQL data directory for the Windows production host. This
# is a running database's on-disk state, not a dev scratch DB — the existing
# `local-postgres/data/` rule above is anchored to the repo root and does not
# reach it. Anchored so it can never hide a source directory of the same name.
/verdura_MVP/local-postgres/
/servvia/local-postgres/

# Decompiled/vendor IdealPOS diagnostic artifacts (third-party IL tooling
# output). Kept on disk for investigation, never redistributed via git.
/.tmp-idealpos-il-tools/

# Admin console / Kitchen Display production build output. The generic
# `dist/` rule above does not match these directories' names; anchored so
# `dist-admin`/`dist-kds` elsewhere in the tree would still be trackable if
# ever legitimate. Each is one VITE_APP_MODE's output -- see
# apps/web/admin-console/vite.config.ts's OUT_DIR_BY_APP_MODE.
/apps/web/admin-console/dist-admin/
/apps/web/admin-console/dist-kds/

# Timestamped rollback copies taken before a production rebuild on the
# Windows host (dist.rollback-*, dist-admin.rollback-*). Machine-local
# operational state, never committed.
/apps/web/admin-console/dist*.rollback-*/

# Venue-connector local capture output (tools/verdura-run-capture.cmd)
apps/venue-connector/.captures/

# Claude Code linked git worktrees. Each subdirectory here is a COMPLETE second
# checkout of this repository (it holds a `.git` gitdir pointer, its own
# node_modules, .env files and build output), so committing one would duplicate
# the entire tree and publish the ignored files inside it. The `.worktrees/`
# rule above is the same policy for the other location and does not match this
# path. Narrow by design: `.claude/skills/` is tracked and must stay tracked.
.claude/worktrees/

# Raw Back-machine investigation evidence — must never be committed
/.tmp-back-evidence/

# Repo-local toolchains for the Servvia migration (e.g. Go). Never commit SDKs or binaries.
scratchpad/toolchains/

# Local-only artifacts of the Servvia migration phases: editor settings,
# screenshot captures, and one-off phase evidence (mutation-test backups,
# migration rehearsal copies, smoke scripts bound to a local environment).
/.idea/
/.tmp-screenshot-review/
/scratchpad/d*-mut/
/scratchpad/d*-upgrade/
/scratchpad/d*-smoke.sh
/scratchpad/d*-smoke/
/scratchpad/bmad-*.txt

# BMAD: per-user install answers and installer backups (not committed)
/_bmad/config.user.toml
/_bmad/**/*.bak
