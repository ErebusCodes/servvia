node_modules/
.DS_Store
**/.DS_Store
test-results/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env
.env.*
!**/.env.example
dist/
dev-dist/
coverage/
*.tsbuildinfo
.worktrees/

# One-off local debug scripts have a history of hardcoding real database
# credentials (see apps/api/db-check.js) — never track these regardless of
# name; write ad-hoc DB checks against .env-sourced config instead.
apps/api/db-check.js
*.env.bak

# Local PostgreSQL development database (disposable — recreated from Prisma
# migrations + seed data). Raw DB files must never be committed.
local-postgres/data/

# Locally uploaded media (menu images etc.) — MediaService writes here at
# runtime; never track user-uploaded content.
apps/api/storage/
*.docx
*.docx

# All video files are ignored by default — Asset/video/intro.mp4 is the one
# master copy we track, and the two symlinks that point to it (instead of
# separate per-app copies) are explicitly allowed through below.
*.mp4
!Asset/video/intro.mp4
!apps/customer-website/public/video/intro.mp4
!apps/window-display/public/video/intro.mp4

AUDIT_REPORT.md
AUDIT_REPORT_V2.md

# Nested live PostgreSQL data directory for the Windows production host. This
# is a running database's on-disk state, not a dev scratch DB — the existing
# `local-postgres/data/` rule above is anchored to the repo root and does not
# reach it. Anchored so it can never hide a source directory of the same name.
/verdura_MVP/local-postgres/

# Decompiled/vendor IdealPOS diagnostic artifacts (third-party IL tooling
# output). Kept on disk for investigation, never redistributed via git.
/.tmp-idealpos-il-tools/

# Admin console production build output. The generic `dist/` rule above does
# not match this directory's name; anchored so `dist-admin` elsewhere in the
# tree would still be trackable if ever legitimate.
/apps/admin-console/dist-admin/
