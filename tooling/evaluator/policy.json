{
  "policy": "servvia.evaluator-policy/v1",
  "description": "Path classes the evaluator applies to every candidate. Governance paths are evaluation authority: a candidate never changes them. Expectation surfaces may change only where the frozen objective authorizes the path; otherwise the change is held for review, or rejected where it removes or disables tests.",
  "governance": [
    "tooling/evaluator/**",
    "_bmad-output/implementation-artifacts/objectives/**",
    "PRD/**",
    "fileRestructure.md",
    "docs/adr/**",
    "_bmad/**",
    ".claude/skills/**"
  ],
  "testFiles": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.integration-spec.ts",
    "**/*.testing-spec.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.mjs",
    "**/*_test.go",
    "**/*Tests.cs",
    "**/*Test.cs"
  ],
  "expectationSurfaces": [
    "**/__snapshots__/**",
    "**/*.snap",
    "**/testsupport/**",
    "**/test/**",
    "**/tests/**",
    "**/fixtures/**",
    "**/package.json",
    "package-lock.json",
    "**/go.mod",
    "**/go.sum",
    "**/jest*.json",
    "**/tsconfig*.json",
    "**/eslint.config.*",
    "**/vite.config.*",
    "**/vitest.config.*",
    "**/test-setup.ts",
    ".github/**",
    "**/*.csproj",
    "**/*.sln",
    "**/*.slnx",
    "**/*.runsettings",
    "**/Directory.Build.props",
    "**/Directory.Build.targets",
    "**/Directory.Packages.props",
    "**/global.json",
    "**/NuGet.Config",
    "**/NuGet.config",
    "**/nuget.config",
    "**/xunit.runner.json"
  ],
  "skipPatterns": [
    "\\b(?:describe|it|test|context|suite)\\.(?:skip|only|todo)\\s*\\(",
    "\\b(?:xit|xtest|xdescribe|fit|fdescribe)\\s*\\(",
    "\\bt\\.(?:Skip|SkipNow|Skipf)\\s*\\(",
    "\\{\\s*(?:skip|only|todo)\\s*:\\s*(?:true|['\"`])",
    "\\bt\\.(?:skip|todo)\\s*\\(",
    "\\[\\s*(?:Xunit\\.)?(?:Fact|Theory|SkippableFact|SkippableTheory)(?:Attribute)?\\s*\\([^\\]]*\\bSkip\\s*=",
    "\\bSkip\\.(?:If|IfNot|When|Unless)\\s*\\(",
    "\\bAssert\\.Skip(?:When|Unless)?\\s*\\("
  ],
  "suppressionPatterns": [
    "eslint-disable",
    "@ts-ignore",
    "@ts-expect-error",
    "@ts-nocheck",
    "//\\s*nolint",
    "#\\s*type:\\s*ignore",
    "istanbul ignore",
    "#\\s*pragma\\s+warning\\s+disable",
    "\\[\\s*(?:assembly\\s*:\\s*)?SuppressMessage\\b"
  ],
  "loop": {
    "maxCorrections": 2,
    "description": "Phase 2: an objective version accepts an initial candidate and at most this many corrections, each evaluated independently."
  }
}
