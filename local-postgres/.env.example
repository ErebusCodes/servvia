# Local-only PostgreSQL configuration for Verdura development.
#
# Copy this file to `local-postgres/.env` and adjust if needed. That file is
# gitignored — never commit it. These are throwaway local-dev credentials for
# a database that only exists on your machine; they are NOT production
# secrets and must never be reused for any real/Supabase/hosted database.
#
# This same shape is what backend/.env's DATABASE_URL should point at for
# local development (see backend/.env.example).

# Port 5432 is the Postgres default, but this machine may already have an
# unrelated Postgres instance bound to it (e.g. a Homebrew service used by
# other projects). To avoid any conflict, Verdura's local dev database
# defaults to 5434 — verified free on this machine (both 5432 and 5433 were
# already in use by unrelated local Postgres instances). Change it here if
# 5434 is also taken on yours.
POSTGRES_PORT=5434

POSTGRES_USER=verdura
POSTGRES_PASSWORD=verdura_local_dev_only
POSTGRES_DB=verdura_dev

# Redis port — matches backend/.env's REDIS_PORT. Change here if 6379 is
# already taken by another local Redis instance.
REDIS_PORT=6379
