{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["./integration-setup.ts"],
  "setupFilesAfterEnv": ["./integration-rate-limit-reset.ts"],
  "testTimeout": 20000
}
