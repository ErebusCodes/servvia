model Staff {
  id             String    @id @default(uuid())
  organizationId String
  email          String    @unique
  name           String
  passwordHash   String
  role           StaffRole
  isActive       Boolean   @default(true)
  totpSecret     String?
  isTotpEnabled  Boolean   @default(false)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  // Argon2id hash of this staff member's short numeric tablet-elevation
  // PIN (story 15-1, DL-081) — deliberately separate from `passwordHash`.
  // Never derived from or equal to the staff member's login password; set
  // only via the dedicated admin/manager-authorized tablet-PIN endpoint.
  // Null until an admin/manager sets one for this staff member.
  pinHash        String?
  pinSetAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization                  Organization            @relation(fields: [organizationId], references: [id])
  tableSessionsOpened           TableSession[]          @relation("TableSessionOpenedBy")
  checksCreated                 Check[]                 @relation("CheckCreatedBy")
  checkPaymentsRequested        CheckPayment[]          @relation("CheckPaymentRequestedBy")
  shifts                        Shift[]                 @relation("ShiftStaff")
  shiftsClosed                  Shift[]                 @relation("ShiftClosedBy")
  cashMovements                 CashMovement[]          @relation("CashMovementActor")
  devicesCreated                Device[]                @relation("DeviceCreatedBy")
  devicesRevoked                Device[]                @relation("DeviceRevokedBy")
  paymentAdjustmentsRequested   PaymentAdjustment[]     @relation("PaymentAdjustmentRequestedBy")
  checksVoided                  Check[]                 @relation("CheckVoidedBy")
  orderRoundsSubmitted          OrderRound[]            @relation("OrderRoundSubmittedBy")
  venueAccess                   VenueAccess[]           @relation("StaffAccess")
  grantsGiven                   VenueAccess[]           @relation("GrantedBy")
  auditLogs                     AuditLog[]              @relation("ActorLogs")
  categoriesCreated             Category[]
  menuItemsCreated              MenuItem[]
  mediaAssetsCreated            MediaAsset[]
  printerReprintsRequested      PrinterJob[]
  connectorEnrollmentsCreated   ConnectorEnrollment[]   @relation("ConnectorEnrollmentCreatedBy")
  connectorInstallationsRevoked ConnectorInstallation[] @relation("ConnectorInstallationRevokedBy")
  connectorCommandsCreated      ConnectorCommand[]      @relation("ConnectorCommandCreatedBy")
  connectorCommandsCancelled    ConnectorCommand[]      @relation("ConnectorCommandCancelledBy")
  tabletEnrollmentsCreated      TabletEnrollment[]      @relation("TabletEnrollmentCreatedBy")
  tabletDevicesRevoked          TabletDevice[]          @relation("TabletDeviceRevokedBy")
  paymentObservationsReviewed   PaymentObservation[]
  promotionsCreated             Promotion[]             @relation("PromotionCreatedBy")
  promotionsUpdated             Promotion[]             @relation("PromotionUpdatedBy")
}

