/// Where an order was placed. Servvia Core (Phase D3) writes only the
/// canonical surfaces: pos_terminal, waiter_tablet, order_tablet, kiosk,
/// customer_web. `staff` and `online` are legacy values written by the NestJS
/// order path (`staff` = any staff surface, unspecified); they stay for
/// existing rows and callers and are never written by Servvia Core.
enum OrderSource {
  kiosk
  staff
  online
  pos_terminal
  waiter_tablet
  order_tablet
  customer_web
}

// Story 15-13: explicit, authoritative service mode for a staff/tablet
// order. Never inferred from tableId/tableNumber/source at read time (see
// OrdersService.createStaffOrder) -- this is the single source of truth.
// Deliberately does not cover the public kiosk path (OrdersService.create),
// which is out of Order Tablet scope and keeps its own pre-existing
// optional-table behavior unchanged.
enum ServiceMode {
  dine_in
  takeaway
}

// Story 2-9: identity lifecycle for an on-premise Verdura Connector
// installation. This enum is deliberately about IDENTITY status only —
// "offline"/"degraded" are connectivity facts derived from `lastSeenAt` at
// read time, never persisted here, since a stored connectivity flag would
// itself go silently stale the moment a connector disconnects.
enum ConnectorInstallationStatus {
  active // the one (per venue, DB-enforced) currently-trusted identity
  revoked // explicitly revoked by an administrator; rejected on every future auth attempt
  replaced // superseded by a newer installation via rotation; rejected identically to revoked
}

enum ConnectorCommandStatus {
  pending // created, not yet claimed by any connector
  claimed // offered to and claimed by a specific active installation under a time-bound lease; not yet accepted
  accepted // CONNECTOR_ACCEPTED — the connector durably persisted responsibility; NOT evidence of any Idealpos/EFTPOS/KDS/printer success
  succeeded // truthful terminal success reported by the connector itself, carrying an operation-specific resultType
  failed // truthful terminal failure reported by the connector itself
  expired // claim/redelivery budget exhausted before ever reaching `accepted` — safe, nothing was ever confirmed accepted
  unknown // reached `accepted` but no terminal report arrived within the reconciliation window — reconciliation required, never auto-retried
  cancelled // administratively cancelled while still pending or claimed; cannot be cancelled once accepted
}

