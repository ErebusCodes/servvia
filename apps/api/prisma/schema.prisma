  pdf
}

// Story 8-1: truthful PrinterJob lifecycle. `printing` is retained only
// because Postgres cannot drop an enum value once created and no data ever
// used it (the queue was never fed in production — see docs/printers.md); no
// code path sets it after this story. `accepted`/`dispatching` replace it
// with states that distinguish "a worker durably claimed this job" from
// "a transport attempt is actively in flight" (the crash-window boundary).
enum PrintJobStatus {
  queued // created, not yet claimed by a worker
  printing // unused legacy value — see comment above
  accepted // worker durably claimed the job; not evidence of dispatch or printing
  dispatching // a transport attempt is in flight; a worker dying here must never be silently resent — see `uncertain`
  delivered // the transport layer accepted the payload (e.g. a TCP write callback fired) — evidence bytes left the server, NOT evidence a ticket printed
  printed // a real device-path acknowledgement was received; unreachable today — no such mechanism exists yet (Story 8-1 Explicit Exclusions)
  manual // no automated dispatch path exists for this connection type (or it is not trusted); staff must handle the ticket manually
  uncertain // dispatch outcome unknown after an interrupted attempt; never auto-retried — resolved only via an explicit, audited reprint
  failed // dispatch was attempted and definitively did not succeed (retries exhausted, or a non-retryable configuration error)
  cancelled // administratively voided before dispatch, or the source order was cancelled before dispatch
  // E8-S1 (expanded, KOT dispatch producer): a durable ConnectorCommand has
  // been created for this print attempt and dispatch responsibility has
  // been handed to the connector-mediated path. NOT evidence of claim,
  // execution, or delivery — those are tracked on the linked
  // ConnectorCommand row (join via PrinterJob.connectorCommandId) and
  // reconciled back onto this job's status only once the command reaches a
  // terminal or quasi-terminal outcome. See printer-dispatcher.service.ts.
  connector_dispatched
}

// KDS delivery is a best-effort broadcast to a browser-based Kitchen Display
// client over a shared per-venue WebSocket room, not a claim-by-one-external-
// connector protocol like PrinterJob/POSSyncRecord — there is no ack channel
// back from the Kitchen Display to the server (KitchenDisplayPage.tsx /
// shared/orders.ts have no such channel; useLiveOrders only refetches on its
// own socket reconnect). `pushed` is therefore the strongest honest terminal
// state this enum can ever reach: it means the server attempted a WebSocket
// emit to the venue's KDS room, never that a Kitchen Display actually
// received or rendered it. Mirrors PrintJobStatus/POSSyncStatus's own
// evidence-tier discipline — no `delivered`/`displayed` value exists here
// because no evidence for either could ever exist with today's transport.
enum KdsDeliveryStatus {
  queued // created, not yet claimed by a dispatch sweep
  pushed // a WebSocket emit to the venue's KDS room was attempted by the dispatcher; NOT evidence a Kitchen Display received or rendered it
  cancelled // the source order was cancelled before/at push time
  exhausted // dispatch attempt budget exceeded; requires manual KDS refresh/verification by staff
}

/// Which POS submission pipeline owns an order. See
/// apps/api/src/pos-sync/pos-submission-strategy.ts for the decision rules and
/// the three enforcement layers; the short version is that a dine-in order
/// takes exactly one of these, chosen in the transaction that creates the
/// order, and nothing changes it afterwards.
enum PosSubmissionStrategy {
  /// The certified Bridge path: POSSyncRecord -> ConnectorCommand
  /// (idealpos.submit_order.v1) -> IdealposBridge -> dbo.WebPendingOrder.
  webit
  /// The handheld path: NativeTableRound -> Order2 over TCP to the till's
  /// WaiterPad listener. No connector, no Bridge, no WebPendingOrder row.
  native_table_round
}

enum POSAdapterType {
  api
  sql
  odbc
  csv
  local_agent
  none
}

enum CalendarSyncStatus {
  synced
  pending
  failed
  not_applicable
}

enum OrgPlan {
  single
