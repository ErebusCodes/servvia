generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  owner
  admin
  manager
  cashier
  kitchen
  viewer
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  completed
  cancelled
}

// Story 9-1: truthful POS-sync lifecycle. `synced` remains structurally
// valid (a future real Idealpos adapter needs it) but is unreachable by any
// code path today — no real adapter exists yet (blocked on decision record
// DL-064; see docs/decisions-log.md). `failed` is reserved for a genuine,
// attempted-and-rejected outcome, which also cannot occur yet for the same
// reason. `unsupported` is the honest classification for "no adapter
// implementation exists for this venue's configured adapter type" — a
// structural fact, not a transient failure, so it is distinct from `failed`
// and is never retried.
enum POSSyncStatus {
  not_synced // created, not yet processed
  // The durable IdealPOS delivery intent has been handed to the Venue
  // Connector as a ConnectorCommand (idealpos.submit_order.v1) and is
  // awaiting a terminal report. Distinct from `not_synced` specifically so
  // the pre-existing (story 9-3) BullMQ dispatch sweep — which still only
  // knows how to mark a row `unsupported` — naturally stops selecting this
  // row the moment a real dispatch attempt begins, without that file
  // needing to change at all.
  queued_for_connector
  // The connector reported that IdealposBridge accepted the HTTP
  // submission (a 2xx response to POST /api/orders, per IdealposBridge's
  // own documented contract). This is NOT evidence that native IdealPOS
  // consumed the order, that the kitchen received it, or that a KOT
  // printed — IdealposBridge's own InsertOrders() call returns void, so
  // "Bridge accepted" is the strongest evidence obtainable from this
  // integration point alone. See `synced` below for the stronger claim
  // this state deliberately does not make.
  submitted_awaiting_confirmation
  synced // a real adapter received an authoritative Idealpos confirmation; unreachable today — no mechanism confirms native consumption yet
  failed // a real adapter attempted submission and Idealpos rejected it, or attempts were exhausted
  not_applicable // posAdapterType is `none` (NullAdapter) — POS sync was never attempted by design
  unsupported // posAdapterType is a real type, but no adapter implementation exists yet — POS sync was never attempted because no adapter could run it
  // This order's POS submission is owned by the NATIVE IdealPOS handheld
  // workflow (NativeTableRound -> Order2 over TCP), not by the Webit
  // connector pipeline. Written at order creation and never changed.
  //
  // It is a distinct status specifically so that BOTH pre-existing dispatcher
  // sweeps stop selecting this row without either query needing to know this
  // strategy exists: PosSyncDispatcherService.sweep() and
  // IdealposOrderDispatcherService.sweepDispatch() both require
  // `status = not_synced`, and this is not that. See
  // pos-submission-strategy.ts for why exclusivity is enforced in three
  // independent layers rather than one.
  //
  // NOT a terminal state in the "we finished" sense - the native round's own
  // lifecycle lives in NativeTableRound/NativeSendAttempt, which is where a
  // native order's real progress is recorded. This row is the durable
  // OWNERSHIP marker, nothing more.
  owned_by_native
  // OrdersService.updateStatus set this order to `cancelled` while its
  // dispatch was still stoppable (not_synced, or queued_for_connector with
  // the underlying ConnectorCommand still pending/claimed — never once it
  // reached ConnectorCommandStatus.accepted). Distinct from `failed`: this
  // was a deliberate staff cancellation, not an error.
  cancelled
}

enum ReservationStatus {
