  online
}

// Story 15-13: explicit, authoritative service mode for a staff/tablet
// order. Never inferred from tableId/tableNumber/source at read time (see
// OrdersService.createStaffOrder) -- this is the single source of truth.
// Deliberately does not cover the public kiosk path (OrdersService.create),
// which is out of Order Tablet scope and keeps its own pre-existing
// optional-table behavior unchanged.
enum ServiceMode {
  dine_in
  takeaway
}

// Story 2-9: identity lifecycle for an on-premise Verdura Connector
// installation. This enum is deliberately about IDENTITY status only —
// "offline"/"degraded" are connectivity facts derived from `lastSeenAt` at
// read time, never persisted here, since a stored connectivity flag would
// itself go silently stale the moment a connector disconnects.
enum ConnectorInstallationStatus {
  active // the one (per venue, DB-enforced) currently-trusted identity
  revoked // explicitly revoked by an administrator; rejected on every future auth attempt
  replaced // superseded by a newer installation via rotation; rejected identically to revoked
}

enum ConnectorCommandStatus {
  pending // created, not yet claimed by any connector
  claimed // offered to and claimed by a specific active installation under a time-bound lease; not yet accepted
  accepted // CONNECTOR_ACCEPTED — the connector durably persisted responsibility; NOT evidence of any Idealpos/EFTPOS/KDS/printer success
  succeeded // truthful terminal success reported by the connector itself, carrying an operation-specific resultType
  failed // truthful terminal failure reported by the connector itself
  expired // claim/redelivery budget exhausted before ever reaching `accepted` — safe, nothing was ever confirmed accepted
  unknown // reached `accepted` but no terminal report arrived within the reconciliation window — reconciliation required, never auto-retried
  cancelled // administratively cancelled while still pending or claimed; cannot be cancelled once accepted
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  billingEmail String
  plan         OrgPlan  @default(single)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venues                 Venue[]
  staff                  Staff[]
  categories             Category[]
  menuItems              MenuItem[]
  posProductIdentities   PosProductIdentity[]
  mediaAssets            MediaAsset[]
  auditLogs              AuditLog[]
  connectorEnrollments   ConnectorEnrollment[]
  connectorInstallations ConnectorInstallation[]
  connectorCommands      ConnectorCommand[]
  tabletEnrollments      TabletEnrollment[]
  tabletDevices          TabletDevice[]
}

model Venue {
  id                     String         @id @default(uuid())
  organizationId         String
  name                   String
  slug                   String
  address                Json
  phone                  String?
  email                  String?
  timezone               String         @default("Pacific/Auckland")
  currency               String         @default("NZD")
  locale                 String         @default("en-NZ")
  taxJurisdiction        String         @default("NZ_GST")
  pricesIncludeTax       Boolean        @default(true)
  operatingHours         Json
  seatingCapacity        Int
  coversPerSlot          Int            @default(20)
  reservationSlotMinutes Int            @default(30)
  posAdapterType         POSAdapterType @default(none)
  posConfig              Json           @default("{}")
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id])
  tables                 Table[]
  floorPlans             FloorPlan[]
  printers               Printer[]
  reservations           Reservation[]
  orders                 Order[]
  venueAccess            VenueAccess[]
  menuItemOverrides      MenuItemVenueOverride[]
  mediaAssets            MediaAsset[]
  printJobs              PrinterJob[]
  posSyncRecords         POSSyncRecord[]
  kdsDeliveryRecords     KdsDeliveryRecord[]
  auditLogs              AuditLog[]
  connectorEnrollments   ConnectorEnrollment[]
  connectorInstallations ConnectorInstallation[]
  connectorCommands      ConnectorCommand[]
  tabletEnrollments      TabletEnrollment[]
  tabletDevices          TabletDevice[]
  table19ValidationRuns    Table19ValidationRun[]
  paymentObservations      PaymentObservation[]
  paymentObservationEvents PaymentObservationEvent[]

  @@unique([organizationId, slug])
}

model Table {
  id          String   @id @default(uuid())
  venueId     String
  tableNumber String
  name        String?
  capacity    Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  floorPlanId String?
  xPosition   Float?
  yPosition   Float?
  // The exact native POS table identifier this Verdura table maps to (for
  // IdealPOS via VerduraIdealposBridge: TableMapSetups.Caption, fetched
  // live from the bridge's GET /api/tables — confirmed by direct source
  // read of Orders/OrderValidator.cs and Idealpos/IdealposReadRepository.cs
  // in /Users/sarwarkhan/Documents/IdealposBridge). Null until staff
  // explicitly configure it — never derived/guessed from tableNumber; the
  // bridge's own docs flag Caption-vs-Code as unconfirmed against a live
  // instance, so Verdura must not assume tableNumber happens to match.
  posTableCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venue        Venue         @relation(fields: [venueId], references: [id])
  floorPlan    FloorPlan?    @relation(fields: [floorPlanId], references: [id])
  reservations Reservation[]
  orders       Order[]

  @@unique([venueId, tableNumber])
  // Prevents two tables in the same venue from being configured to the
  // same native destination by mistake. Postgres unique indexes permit
  // unlimited NULLs, so this never constrains unmapped tables.
  @@unique([venueId, posTableCode])
}

model FloorPlan {
  id           String   @id @default(uuid())
  venueId      String
  name         String
  imageUrl     String?
  canvasWidth  Int      @default(1200)
  canvasHeight Int      @default(800)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venue  Venue   @relation(fields: [venueId], references: [id])
  tables Table[]
}

model Staff {
  id             String    @id @default(uuid())
  organizationId String
  email          String    @unique
  name           String
  passwordHash   String
  role           StaffRole
  isActive       Boolean   @default(true)
  totpSecret     String?
  isTotpEnabled  Boolean   @default(false)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  // Argon2id hash of this staff member's short numeric tablet-elevation
  // PIN (story 15-1, DL-081) — deliberately separate from `passwordHash`.
  // Never derived from or equal to the staff member's login password; set
  // only via the dedicated admin/manager-authorized tablet-PIN endpoint.
  // Null until an admin/manager sets one for this staff member.
  pinHash        String?
  pinSetAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization                  Organization            @relation(fields: [organizationId], references: [id])
  venueAccess                   VenueAccess[]           @relation("StaffAccess")
  grantsGiven                   VenueAccess[]           @relation("GrantedBy")
  auditLogs                     AuditLog[]              @relation("ActorLogs")
  categoriesCreated             Category[]
  menuItemsCreated              MenuItem[]
  mediaAssetsCreated            MediaAsset[]
  printerReprintsRequested      PrinterJob[]
  connectorEnrollmentsCreated   ConnectorEnrollment[]   @relation("ConnectorEnrollmentCreatedBy")
  connectorInstallationsRevoked ConnectorInstallation[] @relation("ConnectorInstallationRevokedBy")
  connectorCommandsCreated      ConnectorCommand[]      @relation("ConnectorCommandCreatedBy")
  connectorCommandsCancelled    ConnectorCommand[]      @relation("ConnectorCommandCancelledBy")
  tabletEnrollmentsCreated      TabletEnrollment[]      @relation("TabletEnrollmentCreatedBy")
  tabletDevicesRevoked          TabletDevice[]          @relation("TabletDeviceRevokedBy")
  paymentObservationsReviewed   PaymentObservation[]
}

