model Table {
  id           String   @id @default(uuid())
  venueId      String
  tableNumber  String
  name         String?
  capacity     Int
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  floorPlanId  String?
  xPosition    Float?
  yPosition    Float?
  // The exact native POS table identifier this Verdura table maps to (for
  // IdealPOS via VerduraIdealposBridge: TableMapSetups.Caption, fetched
  // live from the bridge's GET /api/tables — confirmed by direct source
  // read of Orders/OrderValidator.cs and Idealpos/IdealposReadRepository.cs
  // in /Users/sarwarkhan/Documents/IdealposBridge). Null until staff
  // explicitly configure it — never derived/guessed from tableNumber; the
  // bridge's own docs flag Caption-vs-Code as unconfirmed against a live
  // instance, so Verdura must not assume tableNumber happens to match.
  posTableCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venue        Venue          @relation(fields: [venueId], references: [id])
  floorPlan    FloorPlan?     @relation(fields: [floorPlanId], references: [id])
  reservations Reservation[]
  orders       Order[]
  sessions     TableSession[]

  @@unique([venueId, tableNumber])
  // Prevents two tables in the same venue from being configured to the
  // same native destination by mistake. Postgres unique indexes permit
  // unlimited NULLs, so this never constrains unmapped tables.
  @@unique([venueId, posTableCode])
}

/// One dining visit occupying a table: the guests who sat down, how many
/// they are, who opened the table, and when the visit ended (ADR 0001,
/// Phase D2). Servvia Core (Go) owns it.
///
/// A TableSession is NOT an order, a check, a payment or kitchen state. Open
/// means only "this table is occupied by this visit". Orders, rounds and
/// checks attach to it in later phases; until then no Nest code reads or
/// writes this table, and Order.tableId / Order.guests stay the legacy
/// source for every existing client.
///
/// Covers are visit-level data here. Order.guests remains, unchanged, for
/// legacy clients; nothing copies one into the other.
///
/// Constraints Prisma cannot express, created by hand in
/// migrations/20260929000000_table_sessions and tested by
/// services/core-platform/tests/integration:
///   * "TableSession_one_open_per_table": partial unique index on (tableId)
///     WHERE status = 'open'. At most one open session per table, enforced by
///     the database, not by application code.
///   * CHECK covers BETWEEN 1 AND 99 (the bounds Order.guests already uses).
///   * CHECK version >= 1.
///   * CHECK closedAt IS NULL exactly when status = 'open'.
///   * CHECK openRequestKey length 16..255 (the Order.idempotencyKey bounds).
model TableSession {
  id              String             @id @default(uuid())
  tableId         String
  status          TableSessionStatus @default(open)
  /// Number of guests in the visit, 1..99.
  covers          Int
  /// The staff member whose session or tablet elevation opened the table.
  /// Nullable only so a staff row can never be blocked from deletion by
  /// history; every session opened through Servvia Core records one.
  openedByStaffId String?
  /// Client-generated key of the open request. A retry with the same key on
  /// the same table returns the session it created instead of failing or
  /// opening another (the Order.idempotencyKey pattern, scoped per table).
  openRequestKey  String
  /// Optimistic concurrency: every change must name the version it read and
  /// increments it; a stale version is refused, never overwritten.
  version         Int                @default(1)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  table    Table   @relation(fields: [tableId], references: [id])
  openedBy Staff?  @relation("TableSessionOpenedBy", fields: [openedByStaffId], references: [id], onDelete: SetNull)
  orders   Order[]
  checks   Check[]

  @@unique([tableId, openRequestKey])
  /// Target of Order's composite foreign key (tableSessionId, tableId).
  @@unique([id, tableId])
}

/// Lifecycle of a TableSession. open -> closed (the visit ended) or
/// open -> cancelled (opened in error, no service). Both are terminal.
enum TableSessionStatus {
  open
  closed
  cancelled
}

