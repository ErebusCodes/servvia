/// TRANSITIONAL (Phase D8): Order Tablet identity of the NestJS path. The
/// permanent device registry is Device (kind order_tablet); this model and
/// TabletEnrollment serve existing tablets until the Android Order Tablet
/// migrates, then retire. Not extended.
///
/// LEGACY: a reservation deposit, one per reservation, with Stripe charge
/// fields. No runtime code reads or writes it (audited 2026-09-29, Phase D6).
/// It is NOT the canonical payment: a payment against a check is
/// CheckPayment. Retirement path: drop, or remap to ReservationPayment, in a
/// separately approved migration once reservation deposits are designed.
model Payment {
  id                    String        @id @default(uuid())
  reservationId         String        @unique
  venueId               String
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  amountCents           Int
  currency              String        @default("NZD")
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeReceiptUrl      String?
  confirmedById         String?
  confirmedAt           DateTime?
  referenceNote         String?
  refundedAt            DateTime?
  refundedById          String?
  refundAmountCents     Int?
  refundReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

// Which customer-facing/staff-facing surface a Category or MenuItem may
// render on (Verdura Menu Management architecture, see
// docs/decisions-log.md and _bmad-output/implementation-artifacts/ menu
// management design). Deliberately a fixed, small set backed by a scalar
// Postgres enum array (see MenuItem.visibleChannels doc comment for why
// this is not a join table or a Json field) — extend this enum, not a
// side table, when a new channel is added.
enum MenuChannel {
  order_tablet
  customer_website
  window_display
}

model Category {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  imageUrl        String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  // Deny-by-default (empty array): a freshly created/imported category is
  // invisible on every channel until a human explicitly publishes it —
  // never accidentally visible by omission. See MenuItem.visibleChannels
  // for the full rationale; both fields are always evaluated together by
  // the shared channel resolver.
  visibleChannels MenuChannel[] @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Staff        @relation(fields: [createdById], references: [id])
  menuItems    MenuItem[]
}

model MenuItem {
  id                 String        @id @default(uuid())
  organizationId     String
  categoryId         String
  subCategory        String?
  title              String
  description        String
  imageUrl           String?
  imageThumbnailUrl  String?
  priceCents         Int
  nutritionalDetails Json
  isSpicy            Boolean       @default(false)
  isAvailable        Boolean       @default(true)
  // Promoted from the ad hoc nutritionalDetails.isFeatured JSON convention
  // (Menu Management architecture) to a real, typed, admin-editable column.
  isFeatured         Boolean       @default(false)
  sortOrder          Int           @default(0)
  modifierGroups     Json          @default("[]")
  // Deny-by-default (empty array), same rationale as Category.visibleChannels.
  // Evaluated together with the item's own Category.visibleChannels by the
  // shared channel resolver (apps/api/src/menu/channel-menu-resolver.ts) —
  // an item is only visible on a channel if BOTH it and its category are.
  visibleChannels    MenuChannel[] @default([])
  // DEPRECATED — superseded by the posIdentity relation (PosProductIdentity
  // model, Menu Management architecture). Retained, unchanged, only until
  // every reader of this column (chiefly the IdealPOS payload mapper) has
  // cut over to `posIdentity.nativeCode`; do not add new consumers of this
  // field. See PosProductIdentity's own doc comment for the replacement.
  //
  // The exact native POS product/stock-item code this menu item maps to
  // (for IdealPOS via VerduraIdealposBridge: the `code` field of GET
  // /api/products, confirmed by direct source read of
  // Orders/OrderValidator.cs and Idealpos/IdealposReadRepository.cs in
  // /Users/sarwarkhan/Documents/IdealposBridge). Null until staff
  // explicitly configure it — never derived/guessed from this MenuItem's
  // own id or title; the bridge does no name-based product matching, only
  // an exact code match against IdealPOS's own live product list.
  posProductCode     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdById        String
  deletedAt          DateTime?

  organization   Organization            @relation(fields: [organizationId], references: [id])
  category       Category                @relation(fields: [categoryId], references: [id])
  createdBy      Staff                   @relation(fields: [createdById], references: [id])
  venueOverrides MenuItemVenueOverride[]
  orderItems     OrderItem[]
  posIdentity    PosProductIdentity?

  // DEPRECATED, retained alongside posProductCode above until Phase E of
  // the Menu Management migration drops this column entirely — see
  // PosProductIdentity's own @@unique([organizationId, sourceSystem,
  // nativeCode]) for its structural replacement, which does not require a
  // MenuItem row to exist at all in order to hold a candidate code.
  //
  // Prevents two menu items in the same organization from being configured
  // to the same native product code by mistake. Postgres unique indexes
  // permit unlimited NULLs, so this never constrains unmapped items. Not
  // scoped per-venue: a single IdealposBridge instance targets one
  // IdealPOS database with no multi-tenant support (confirmed, bridge
  // README "No multi-tenant/multi-site support"), and this org's
  // production venue set is single-venue today — a genuinely different
  // per-venue PLU numbering scheme would require re-scoping this to
  // MenuItemVenueOverride instead, deliberately deferred rather than
  // built speculatively against unevidenced multi-venue requirements.
  @@unique([organizationId, posProductCode])
}

model MenuItemVenueOverride {
  id          String   @id @default(uuid())
  menuItemId  String
  venueId     String
  priceCents  Int?
  isAvailable Boolean?
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  venue    Venue    @relation(fields: [venueId], references: [id])

  @@unique([menuItemId, venueId])
}

// Menu Management architecture: the source-of-truth POS product identity,
// deliberately NOT a MenuItem row. Supersedes the old pattern where the
// entire live IdealPOS catalog was mirrored into "Imported from IdealPOS
// (pending review)" MenuItem rows in order to make PLU codes discoverable
// — that made every candidate code compete with curated items for
// MenuItem.posProductCode's uniqueness constraint, forcing a manual
// "clear the staging row, then set the curated row" transfer for every
// single mapping. A PosProductIdentity row can hold a nativeCode
// indefinitely without ever being a MenuItem, so linking becomes one
// guarded update (menuItemId: null -> <id>) instead of two.
enum PosSourceSystem {
  idealpos
}

// Evidence-tier lifecycle status, same discipline as POSSyncStatus above:
// only claims what has actually been established for this candidate.
enum PosSourceLifecycleStatus {
  // Synced from the POS catalog, not yet linked to any MenuItem. Replaces
  // the old "Imported from IdealPOS (pending review)" Category-name hack —
  // this is now a real, typed status, not a string match.
  pending_review
  // Linked to a MenuItem and currently treated as genuinely sellable.
  active
  // Linked, but staff have deliberately paused this pairing without
  // unlinking it (e.g. temporarily 86'd at the source).
  hidden
  // Linked; available evidence suggests this is not currently sellable.
  // Advisory only — never auto-set from an unproven signal.
  unavailable
  // A previously-synced nativeCode no longer appeared in the most recent
  // sync pass.
  source_missing
  // Reserved for a future venue/signal where a real POS-side inactive flag
  // is trustworthy. Never populated from IdealPOS StockItems.Discontinue
  // at this venue — confirmed 100% false across the entire live catalog
  // (826/826 rows), i.e. proven non-diagnostic, not merely unused.
  source_inactive
}

// Advisory confidence tier for sorting the admin review queue — never a
// gate. A candidate's lifecycleStatus stays pending_review regardless of
// tier until a human explicitly links it; nothing becomes customer-visible
// from this classification alone. See classifyPosCandidate in
// apps/api/src/pos-sync/classify-pos-candidate.ts for the decision table
// this was derived from, grounded in this venue's real IdealPOS evidence
// (TouchscreenGridDetails placement, Department 41 "Verdura Takeaway"
// duplicate-detection).
enum PosCandidateConfidenceTier {
  high_confidence_active
  likely_active
  ambiguous
  takeaway_duplicate
  // Reserved: no evidence-backed automated detector for "this is
  // packaging/a modifier, not a standalone dish" existed at classifier
  // design time (StockItems.Condiment was tested and found non-diagnostic
  // at this venue — 793/826 rows flagged true, including 8 of 9 known-good
  // real dine-in items). Never populated by v1.
  operational_non_menu
  // Reserved: same caveat — no trustworthy live inactive/discontinued
  // signal was found at this venue (see source_inactive above).
  inactive
}

model PosProductIdentity {
  id                String          @id @default(uuid())
  organizationId    String
  sourceSystem      PosSourceSystem @default(idealpos)
  // StockItems.Code, verbatim, never derived from a title or id.
  nativeCode        String
  // StockItems.Description snapshot at last sync, kept purely for
  // human-readable drift detection (see descriptionDriftDetectedAt) — not
  // rendered to customers anywhere; MenuItem.title is Verdura's own.
  nativeDescription String

  lifecycleStatus PosSourceLifecycleStatus    @default(pending_review)
  confidenceTier  PosCandidateConfidenceTier?
  // Raw classifier signal snapshot at last (re)classification — e.g.
  // { hasAnyGridPlacement, hasVisibleGridPlacement, departmentCode,
  // isDepartment41, hasDepartment41TwinSameDescription, twinNativeCode }.
  // Kept for audit/debugging, never parsed by the resolver.
  evidence        Json                        @default("{}")

  // IdealPOS's own live sale price (StockItemsValue, Type=1/"Price",
  // Level=1) as of the last sync. The routine background sync
  // (sync-pos-catalog.ts) populates this for every candidate but never
  // consumes it to set MenuItem.priceCents automatically — Verdura's own
  // priceCents remains authoritative there so an unattended sync can never
  // silently change what customers are charged. It otherwise exists to
  // power an admin-visible price drift warning once linked (real drift
  // already found live: Pesto Chicken Pizza and Spicy Mediterranean Pizza
  // both $23.50 in Verdura vs $23.00 in IdealPOS at sync time).
  //
  // One deliberate, human-reviewed exception: the one-time authoritative
  // menu migration (prisma/scripts/menu-migration/) DOES set
  // MenuItem.priceCents from this value for its screenshot-confirmed,
  // manifest-approved items — that's an explicit, reviewed migration
  // decision (IdealPOS price is the source of truth for that one cutover),
  // not the routine sync described above.
  priceCentsFromPos Int?
  priceLastSyncedAt DateTime?

  lastSyncedAt               DateTime?
  descriptionDriftDetectedAt DateTime?

  // Null while still an unlinked candidate. Once set, this row and its
  // linked MenuItem are the sole source of the native code that reaches
  // the IdealPOS payload mapper — see MenuItem.posIdentity.
  menuItemId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  menuItem     MenuItem?    @relation(fields: [menuItemId], references: [id])

  // The direct structural replacement for MenuItem's old
  // @@unique([organizationId, posProductCode]) collision: uniqueness lives
  // on the identity row itself, never on two competing MenuItem rows.
  @@unique([organizationId, sourceSystem, nativeCode])
  @@index([organizationId, lifecycleStatus, confidenceTier])
}

// Story: GCS canonical media (2026-08-17). A MediaAsset row is the
// authoritative record of one uploaded object in cloud storage — it is
// created before the bytes exist (`pending_upload`) and only becomes
// safe to render once `approved`. `MenuItem.imageUrl`/`Category.imageUrl`
// remain the fields frontends actually render (unchanged); on approval the
// resolved delivery URL for a MediaAsset is written into those fields, so
// no frontend rendering code needs to know MediaAsset exists at all.
enum MediaAssetPurpose {
  menu_item
  category
  promotion
  venue_gallery
  branding
  video
  document
}

enum MediaAssetType {
  image
  video
}

enum StorageProvider {
  gcs
  local // dev/test only — MediaService's existing local-disk path; never used for a real MediaAsset row in production
}

// Every transition is explicit and one-directional except the final
// terminal states; nothing here is ever inferred from an HTTP 200 or a
// missing error — see MediaAssetsService for the state machine.
enum MediaAssetStatus {
  pending_upload // row created, signed upload URL issued, object not yet confirmed in the bucket
  uploaded // client reported success; object existence/size/checksum not yet server-verified
  validating // server is verifying the object (HEAD request, checksum, MIME sniff, dimension/duration probe)
  approved // verified and safe to render; only status a delivery URL will be generated for
  rejected // failed validation (checksum/MIME/size/dimension mismatch) — object is deleted from the bucket, never served
  failed // upload never completed (client error, abandoned, or expired signed URL) — swept by the abandoned-upload lifecycle policy
  archived // previously approved, superseded by a newer MediaAsset or manually retired — object retained for rollback, never served as current
}

enum MediaAssetVisibility {
  private // default; only ever resolved via a short-lived signed GET URL
  public // approved delivery copy under an immutable/versioned key; long-lived cache headers are safe because the key never changes meaning
}

model MediaAsset {
  id               String               @id @default(uuid())
  organizationId   String
  venueId          String
  purpose          MediaAssetPurpose
  mediaType        MediaAssetType
  storageProvider  StorageProvider      @default(gcs)
  bucket           String
  objectKey        String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String // sha256, hex-encoded — see MediaAssetsService for the dedup-by-checksum-per-venue lookup this enables
  width            Int?
  height           Int?
  durationMs       Int?
  altText          String?
  status           MediaAssetStatus     @default(pending_upload)
  visibility       MediaAssetVisibility @default(private)
  cacheVersion     Int                  @default(1)
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])
  createdBy    Staff        @relation(fields: [createdById], references: [id])

  // One object key can only ever back one row — prevents two rows from
  // silently racing to claim the same bucket path.
  @@unique([bucket, objectKey])
  // Fast per-venue duplicate lookup before issuing a new upload URL.
  @@index([venueId, checksum])
  @@index([venueId, purpose, status])
}

model Order {
  id                           String        @id @default(uuid())
  venueId                      String
  tableId                      String?
  tableNumber                  String?
  /// Phase D3: the table session (visit) this order belongs to. Set by
  /// Servvia Core for every table-service order, and then tableId and
  /// tableNumber are derived from the session's table, never taken from the
  /// client. Null for historical orders, for orders created by the NestJS
  /// path, and for orders with no table (takeaway). A session may hold
  /// several orders; table occupancy is the session's, not the orders'.
  tableSessionId               String?
  status                       OrderStatus   @default(pending)
  /// Legacy external-POS mirror. The NestJS path always sets it explicitly.
  /// The default is `not_applicable` (Phase D3) because the only writer that
  /// relies on it is Servvia Core, whose orders have no external POS.
  posSyncStatus                POSSyncStatus @default(not_applicable)
  subtotalCents                Int
  /// Phase D11: the promotion discount on subtotalCents, the sum of the
  /// lines' discountCents. totalCents = subtotalCents - discountCents, and
  /// taxCents is the GST contained in that discounted total. 0 for every
  /// order without a promotion, including all history and the NestJS path.
  discountCents                Int           @default(0)
  taxCents                     Int           @default(0)
  totalCents                   Int
  notes                        String?
  source                       OrderSource   @default(kiosk)
  // Story 15-13: explicit, authoritative dine-in/takeaway service mode.
  // Defaults to dine_in for the additive migration's backfill (every
  // pre-existing order predates the takeaway capability -- see migration
  // 20260821000000_order_service_mode's own comment) and because the public
  // kiosk path (untouched by this story) has never had any other concept.
  // takeawayReference is populated only for serviceMode = takeaway, from a
  // dedicated Postgres sequence (never a "latest row + 1" read) -- see
  // OrdersService.persistOrder.
  serviceMode                  ServiceMode   @default(dine_in)
  /// Covers, as the waiter set them when opening the table.
  ///
  /// Nullable because it genuinely is unknown for every historical order and
  /// for takeaway, which has no covers. Before this column existed the Order
  /// Tablet smuggled the count through `notes` as the free text "Guests: N"
  /// and fell back to a hardcoded 2 when the pattern did not match - fine for
  /// a display hint, not fine for `<Guests>` in a native Order2 packet, where
  /// a guessed number is sent to the till as fact.
  guests                       Int?
  takeawayReference            String?
  // Story 6-1: database-enforced idempotency + payment-reference uniqueness.
  // idempotencyKey is required and scoped per venue (venueId already fixes
  // organizationId 1:1 via Venue, so (venueId, idempotencyKey) gives the
  // same isolation as (organizationId, venueId, idempotencyKey) without a
  // denormalized organizationId column on Order).
  idempotencyKey               String
  // Provider-neutral payment reference (populated from stripePaymentIntentId
  // today). Null for orders with no online payment (e.g. staff-tablet).
  // Globally unique when present — Postgres unique indexes permit unlimited
  // NULLs, so this does not constrain payment-less orders.
  paymentProviderTransactionId String?
  submittedAt                  DateTime      @default(now())
  confirmedAt                  DateTime?
  preparingAt                  DateTime?
  readyAt                      DateTime?
  completedAt                  DateTime?
  cancelledAt                  DateTime?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  venue                    Venue                     @relation(fields: [venueId], references: [id])
  table                    Table?                    @relation(fields: [tableId], references: [id])
  /// Composite key: an order's table is, by database constraint, the table
  /// of its session. A session is never deleted from under its orders.
  tableSession             TableSession?             @relation(fields: [tableSessionId, tableId], references: [id, tableId], onDelete: Restrict)
  items                    OrderItem[]
  rounds                   OrderRound[]
  kitchenTickets           KitchenTicket[]
  checkLines               CheckLine[]
  printJobs                PrinterJob[]
  posSyncRecord            POSSyncRecord?
  kdsDeliveryRecord        KdsDeliveryRecord?
  table19ValidationRun     Table19ValidationRun?
  // Story 15-6: native IdealPOS payment-state OBSERVATION only -- never
  // written by anything in this codebase that initiates, selects tender
  // for, or otherwise processes payment. Absence of this row means
  // `not_observed`, by design -- no backfill/eager-creation is needed or
  // performed for historical orders (see PaymentObservation's own doc
  // comment).
  paymentObservation       PaymentObservation?
  paymentObservationEvents PaymentObservationEvent[]
  /// Native IdealPOS delta rounds for this table session. Empty for every
  /// order that never used the native handheld path, including all history.
  nativeRounds             NativeTableRound[]
  appliedPromotions        AppliedPromotion[]

  @@unique([venueId, idempotencyKey])
  /// Target of AppliedPromotion's composite foreign key (orderId, venueId).
  @@unique([id, venueId])
  @@unique([paymentProviderTransactionId])
  @@unique([takeawayReference])
  @@index([tableSessionId])
}

/// Table 19 controlled live-validation guard (Order Tablet "Send to Kitchen"
/// / Idealpos+KDS+KOT orchestration validation). Enforces "one controlled
/// logical order only unless explicitly reset by an authorised operator" --
/// see OrdersService.assertTable19ValidationModeAllows. Entirely inert
/// unless TABLE19_LIVE_TEST_ENABLED/TABLE19_LIVE_TEST_VENUE_ID are both set
/// and NODE_ENV !== 'production'.
model Table19ValidationRun {
  id             String    @id @default(uuid())
  venueId        String
  orderId        String    @unique
  createdAt      DateTime  @default(now())
  resetAt        DateTime?
  resetByStaffId String?

  venue Venue @relation(fields: [venueId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([venueId, resetAt])
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  menuItemId        String
  menuItemTitle     String
  menuItemCategory  String
  unitPriceCents    Int
  quantity          Int
  lineTotalCents    Int
  selectedModifiers Json    @default("[]")
  notes             String?
  // Optional per-seat assignment for the Order Tablet dine-in flow. Nullable
  // and unconstrained-by-default so this is a backward-compatible additive
  // column: existing rows (and any order without a seat) stay NULL, which the
  // whole pipeline treats as "no seat — the native server decides", never
  // seat 0. Carried through to IdealposOrderPayload.items[].seat ->
  // OrderLineRequest.Seat -> native SeatNumber. Positive integer or NULL only
  // (normalized in OrdersService.resolveOrderItems, consistent with
  // buildIdealposOrderPayload).
  seat              Int?

  /// Which native delta round carried this line to IdealPOS. NULL means the
  /// line has not been assigned to a round - true for every historical row
  /// and for any order on the Webit path. A line whose round is `confirmed`
  /// is never swept into a later round: that is what makes a second Send to
  /// Kitchen a delta rather than a replay of the whole tab.
  nativeRoundId String?

  /// Phase D3: the canonical round (submission) that added this line. Null
  /// for lines created by the NestJS path.
  roundId String?

  /// Phase D11: this line's share of its round's promotion discount, as
  /// accepted (0..lineTotalCents). lineTotalCents stays unitPriceCents x
  /// quantity; the line pays lineTotalCents - discountCents.
  discountCents      Int     @default(0)
  /// The promotion applied to this line's round, when the line was eligible
  /// for it. Null (and discountCents 0) otherwise.
  appliedPromotionId String?

  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem         MenuItem           @relation(fields: [menuItemId], references: [id])
  nativeRound      NativeTableRound?  @relation(fields: [nativeRoundId], references: [id], onDelete: SetNull)
  round            OrderRound?        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  /// Composite key: the applied promotion is of this line's own order.
  appliedPromotion AppliedPromotion?  @relation(fields: [appliedPromotionId, orderId], references: [id, orderId], onDelete: NoAction)
  kitchenLine      KitchenTicketLine?
  checkLines       CheckLine[]

  /// Target of CheckLine's composite foreign key (orderItemId, orderId).
  @@unique([id, orderId])
  @@index([nativeRoundId])
  @@index([roundId])
  @@index([appliedPromotionId])
}

/// One submission of requested items to an order (Phase D3): round 1 is the
/// order's creation, later rounds add items at the same table session.
/// Written only by Servvia Core. A round is immutable once submitted; what
/// the kitchen does with it is KitchenTicket state (Phase D4), not a round
/// state. Unrelated to NativeTableRound, the legacy IdealPOS delivery model.
///
/// Hand-written CHECKs in migration 20260930000000_canonical_orders:
/// sequence >= 1, requestKey length 16..255.
model OrderRound {
  id                 String   @id @default(uuid())
  orderId            String
  /// 1, 2, 3... per order, in submission order.
  sequence           Int
  /// Client-generated idempotency key of the submission, unique per order.
  /// Round 1 uses the order's own idempotencyKey.
  requestKey         String
  submittedByStaffId String?
  submittedAt        DateTime @default(now())

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedBy       Staff?             @relation("OrderRoundSubmittedBy", fields: [submittedByStaffId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  kitchenTickets    KitchenTicket[]
  /// At most one: AppliedPromotion.roundId is unique.
  appliedPromotions AppliedPromotion[]

  @@unique([orderId, sequence])
  @@unique([orderId, requestKey])
  /// Target of KitchenTicket's composite foreign key (roundId, orderId).
  @@unique([id, orderId])
}

/// Transactional outbox of canonical Servvia events (Phase D3). A row is
/// written in the same transaction as the state change it announces; a
/// consumer (the Phase D4 kitchen) processes it later and stamps
/// processedAt. Deliberately generic: no IdealPOS, connector or KDS
/// transport fields. Today's only event type is `order.round_submitted`.
model OutboxEvent {
  id            String    @id @default(uuid())
  venueId       String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  /// Phase D4 bounded retry: failed processing attempts so far, the last
  /// error, and the earliest time the next attempt may run (exponential
  /// backoff). After the consumer's attempt limit, failedAt parks the event:
  /// it is never retried again automatically and never silently dropped.
  attempts      Int       @default(0)
  lastError     String?
  availableAt   DateTime  @default(now())
  failedAt      DateTime?

  venue Venue @relation(fields: [venueId], references: [id])

  @@index([processedAt, createdAt])
}

/// What the kitchen is expected to prepare (Phase D4): one ticket per order
/// round per station, projected by Servvia Core from the round's
/// `order.round_submitted` outbox event. Kitchen progress lives here and
/// never in Order.status, which D4 does not write. Lines are snapshots, so a
/// ticket survives menu changes.
///
/// (roundId, station) is unique: a replayed or concurrently projected event
/// cannot create a second ticket for the same work. The station is chosen by
/// the server (kitchen.Router), never by a client.
///
/// Hand-written CHECKs in migration 20261001000000_kitchen_tickets: version
/// >= 1, station format, and each stage timestamp set once reached.
model KitchenTicket {
  id                String              @id @default(uuid())
  venueId           String
  orderId           String
  roundId           String
  /// Server-routed station, e.g. "kitchen". [a-z0-9_-], 1..40 characters.
  station           String
  status            KitchenTicketStatus @default(new)
  /// Optimistic concurrency: a change names the version it read.
  version           Int                 @default(1)
  /// The outbox event this ticket was projected from (no foreign key: the
  /// outbox may be pruned, tickets are history).
  sourceEventId     String
  /// Display snapshots taken at projection: the round's sequence, the
  /// table or takeaway reference, and the order's source.
  roundSequence     Int
  tableNumber       String?
  takeawayReference String?
  orderSource       OrderSource
  acknowledgedAt    DateTime?
  preparingAt       DateTime?
  readyAt           DateTime?
  completedAt       DateTime?
  recalledAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  venue       Venue                     @relation(fields: [venueId], references: [id])
  order       Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Composite key: a ticket's order is, by database constraint, the order
  /// of its round.
  round       OrderRound                @relation(fields: [roundId, orderId], references: [id, orderId], onDelete: Cascade)
  lines       KitchenTicketLine[]
  transitions KitchenTicketTransition[]

  @@unique([roundId, station])
  @@index([venueId, station, status])
  @@index([orderId])
}

/// One order line on a kitchen ticket (Phase D4). orderItemId is unique, so
/// a line is prepared on exactly one ticket, whatever the retries.
model KitchenTicketLine {
  id          String  @id @default(uuid())
  ticketId    String
  orderItemId String  @unique
  /// Position of the line within its round, from 1.
  position    Int
  title       String
  quantity    Int
  /// Resolved modifiers as ordered (the OrderItem.selectedModifiers snapshot).
  modifiers   Json    @default("[]")
  notes       String?
  seat        Int?

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([ticketId, position])
}

/// Kitchen ticket history (Phase D4): every status change with its actor.
/// Not AuditLog, whose actor must be a Staff row: a KDS device token is not
/// one. actorId is the token subject (a staff id, or `kds-device:<venueId>`).
model KitchenTicketTransition {
  id         String              @id @default(uuid())
  ticketId   String
  fromStatus KitchenTicketStatus
  toStatus   KitchenTicketStatus
  /// The ticket version this change produced.
  version    Int
  actorId    String
  actorKind  String
  actorRole  StaffRole
  at         DateTime            @default(now())

  ticket KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, version])
}

/// Kitchen progress of a ticket. new -> acknowledged -> preparing -> ready
/// -> completed (a ticket may skip acknowledged); completed -> recalled
/// brings a bumped ticket back, and recalled -> preparing | ready |
/// completed. Transitions are enforced by Servvia Core (internal/kitchen).
enum KitchenTicketStatus {
  new
  acknowledged
  preparing
  ready
  completed
  recalled
}

model Printer {
  id             String                @id @default(uuid())
  venueId        String
  name           String
  type           PrinterType
  connectionType PrinterConnectionType
  protocol       PrinterProtocol       @default(escpos)
  host           String?
  port           Int?
  sharePath      String?
  paperWidthMm   Int                   @default(80)
  charPerLine    Int                   @default(42)
  isActive       Boolean               @default(true)
  isOnline       Boolean?
  lastSeenAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  venue     Venue        @relation(fields: [venueId], references: [id])
  printJobs PrinterJob[]
}

model PrinterJob {
  id            String          @id @default(uuid())
  printerId     String
  orderId       String?
  venueId       String
  status        PrintJobStatus  @default(queued)
  payload       String
  payloadFormat PrinterProtocol
  attemptCount  Int             @default(0)
  maxAttempts   Int             @default(3)
  queuedAt      DateTime        @default(now())
  lastAttemptAt DateTime?
  // Set only when the transport layer accepted the payload (e.g. a TCP
  // write callback fired) — NOT proof of physical printing. See `printedAt`.
  deliveredAt   DateTime?
  // Set only from real device-path acknowledgement evidence. Unreachable
  // today — see PrintJobStatus.printed.
  printedAt     DateTime?
  failedAt      DateTime?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Story 8-1 reprint lineage: a reprint is a brand-new job row, never a
  // mutation of the original, so the original's own history stays intact.
  // Nullable — most jobs are not reprints.
  reprintOfId          String?
  reprintRequestedById String?

  // E8-S1 (expanded, KOT dispatch producer): outbox-dispatch bookkeeping,
  // mirroring POSSyncRecord's dispatch* fields (story 9-3) exactly. None of
  // these fields are evidence of anything reaching a connector or printer —
  // they record only whether/when this job has been handed to the
  // connector-mediated dispatch path (a ConnectorCommand row was durably
  // created for it). The same invariant POSSyncRecord documents applies:
  // dispatchClaimId and dispatchClaimExpiresAt are always written together
  // by PrinterDispatcherService's own updateMany calls, never independently.
  connectorCommandId     String?   @unique
  dispatchClaimId        String? // owner token for the current dispatch claim, if any
  dispatchClaimedAt      DateTime? // when the current dispatch claim was acquired
  dispatchClaimExpiresAt DateTime? // lease expiry; an expired claim is re-claimable
  dispatchedAt           DateTime? // set only after the ConnectorCommand was durably created
  dispatchAttemptCount   Int       @default(0) // producer's own claim/command-creation attempts
  lastDispatchError      String? // sanitized: command-creation failure reason only, never a raw stack/secret
  dispatchExhaustedAt    DateTime? // set once dispatchAttemptCount exceeds the configured budget; job becomes `manual`

  printer            Printer           @relation(fields: [printerId], references: [id])
  order              Order?            @relation(fields: [orderId], references: [id])
  venue              Venue             @relation(fields: [venueId], references: [id])
  reprintOf          PrinterJob?       @relation("PrinterJobReprints", fields: [reprintOfId], references: [id])
  reprints           PrinterJob[]      @relation("PrinterJobReprints")
  reprintRequestedBy Staff?            @relation(fields: [reprintRequestedById], references: [id])
  connectorCommand   ConnectorCommand? @relation(fields: [connectorCommandId], references: [id])

  @@index([status, dispatchExhaustedAt, queuedAt])
}

model POSSyncRecord {
  id          String         @id @default(uuid())
  orderId     String         @unique
  venueId     String
  adapterType POSAdapterType
  status      POSSyncStatus  @default(not_synced)

  /// WHICH PIPELINE OWNS THIS ORDER. Written once, in the same transaction
  /// that creates the order, and never updated by any code path in this
  /// repository. `webit` is the default, so every row that existed before this
  /// column did means exactly what it always meant and production is
  /// unchanged.
  ///
  /// This is the authoritative routing decision. `status = owned_by_native`
  /// keeps a native order out of both sweeps' candidate sets on its own; this
  /// column is what lets a sweep, a retry worker or a repair script ASK who
  /// owns a row rather than infer it from a status that other code may move.
  strategy        PosSubmissionStrategy @default(webit)
  requestPayload  Json?
  responsePayload Json?
  posOrderId      String?
  posTableId      String?
  // Reserved for a real Idealpos adapter's own submission attempts
  // (target-operating-model.md; story 9-1). Story 9-3's dispatcher
  // deliberately does NOT touch these — see dispatch* fields below.
  attemptCount    Int                   @default(0)
  lastAttemptAt   DateTime?
  syncedAt        DateTime?
  failedAt        DateTime?
  errorMessage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Story 9-3: outbox-dispatch bookkeeping only. None of these fields are
  // evidence of anything reaching Idealpos, a connector, or any external
  // system — they record only whether this record has been handed to the
  // cloud-internal `pos-sync` BullMQ queue for the already-truthful
  // PosSyncProcessor (story 9-1, unchanged) to classify. Deliberately kept
  // separate from POSSyncStatus and from attemptCount/lastAttemptAt above,
  // which are reserved for a real adapter's own (currently nonexistent)
  // Idealpos-facing attempts.
  // Invariant (independent review, 2026-08-16): dispatchClaimId and
  // dispatchClaimExpiresAt are always written together by
  // PosSyncDispatcherService's own updateMany calls — never set
  // independently. If something other than that service ever sets one
  // without the other (e.g. a future manual data-repair script), the
  // resulting row would satisfy neither of sweep()'s eligibility branches
  // and would never be picked up again short of dispatchExhaustedAt. Not
  // reachable through any code path in this codebase today; flagged here
  // so it stays that way.
  dispatchClaimId        String? // owner token for the current claim, if any
  dispatchClaimedAt      DateTime? // when the current claim was acquired
  dispatchClaimExpiresAt DateTime? // lease expiry; an expired claim is re-claimable
  dispatchedAt           DateTime? // set only after queue.add() resolved without throwing
  dispatchAttemptCount   Int       @default(0) // dispatcher's own claim attempts, not Idealpos attempts
  lastDispatchError      String? // sanitized: enqueue/claim failure reason only, never a raw stack/secret
  dispatchExhaustedAt    DateTime? // set once dispatchAttemptCount exceeds the configured budget; excluded from further auto-retry

  // ── IdealPOS connector delivery (this story) ──
  // The ConnectorCommand (idealpos.submit_order.v1) created once this
  // record's order was proven eligible (buildIdealposOrderPayload
  // succeeded — real table/PLU mapping, no modifiers). Nullable: an
  // ineligible order goes straight to `failed` and never gets one. Once
  // set, this row is permanently outside the pre-existing (story 9-3)
  // BullMQ dispatcher's candidate set — see `status`'s own
  // `queued_for_connector` doc comment — so no change was needed there.
  // Unique: at most one live delivery command per durable order; reusing
  // the same idempotencyKey (the order's own id) on a retried dispatch
  // attempt returns this same command rather than creating a second one.
  connectorSubmitCommandId String? @unique

  // DL-092: a transient Bridge/connector delivery failure
  // (bridge_unreachable_or_failed, or a ConnectorCommand that expired
  // before ever being claimed/accepted — zero side effects either way) no
  // longer becomes an immediate terminal `failed`. Instead the record
  // returns to `not_synced` (re-eligible for sweepDispatch, which already
  // reuses that exact status/attemptCount gate for "never yet attempted")
  // and this column records the earliest time it may be retried again.
  // Null means immediately eligible — true for both a record that has
  // never been attempted and one whose backoff window has already
  // elapsed. Mirrors dispatchClaimExpiresAt's lease-gate pattern above,
  // one model up the file, applied to the connector-delivery attempt
  // counter (attemptCount) instead of the internal-queue one
  // (dispatchAttemptCount).
  nextRetryAt DateTime?

  // DL-092: set once attemptCount reaches the configured retry ceiling
  // after one or more transient (never deterministic) failures — mirrors
  // dispatchExhaustedAt's established pattern above. A record with this
  // set is `failed` for the same structural reason as a deterministic
  // mapping/Bridge-rejection failure, but errorMessage/this timestamp
  // together tell an operator the difference: exhausted retries after a
  // real, repeated delivery attempt, not an immediate contract violation.
  retryExhaustedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@index([status, dispatchExhaustedAt, createdAt])
  @@index([status, attemptCount, createdAt])
  @@index([status, nextRetryAt])
}

// ── Story 15-6: native IdealPOS payment-state OBSERVATION/reconciliation ──
//
// Deliberately a SEPARATE domain from POSSyncRecord above. POSSyncRecord
// tracks whether an ORDER reached Idealpos (submission); PaymentObservation/
// PaymentObservationEvent below track whether native Idealpos/EFTPOS later
// reports the order as PAID -- a distinct, later lifecycle leg that this
// codebase has never modelled before (DL-087: the Order Tablet never
// processes or initiates payment; payment happens later, entirely inside
// Idealpos/EFTPOS; Verdura may only observe and reconcile the resulting
// native state). Do not conflate the two models, and do not derive
// PaymentObservationState from POSSyncStatus/ConnectorCommandStatus/
// KdsDeliveryStatus -- none of those are payment states, and coupling them
// would let order-submission or kitchen-delivery activity be mistaken for
// evidence of payment.
//
// Current Bridge-contract reality (confirmed by direct source read of
// /Users/sarwarkhan/Documents/IdealposBridge): there is no `/pay` endpoint
// and no proven payment-observation endpoint or tender field. The bridge's
// own order-lifecycle model does include `paid`/`closed` values, but its
// own doc comment labels them HEURISTIC ("inferred... not directly
// proven"), and no connector-side code in this repository polls for or
// reports them today. This domain model is built so a FUTURE, versioned,
// connector-reported observation can be added without a schema replacement
// or state reinterpretation -- until then, every real order's payment state
// is honestly `not_observed` or `observation_unsupported`, fed only by this
// story's own fixture-injection endpoint for contract testing.
enum PaymentObservationState {
  not_observed // no payment evidence has ever been received for this order -- the default; absence of a row means this too
  observation_unsupported // the venue's adapter/Bridge cannot currently report payment at all (posAdapterType != api, or no supported observation contract exists yet)
  pending // a supported source explicitly reports payment is pending/in progress
  paid // a supported AUTHORITATIVE source explicitly reports successful payment
  declined // a supported source explicitly reports a decline
  cancelled // payment was explicitly cancelled before settlement
  reversed // a supported source explicitly reports a reversal of a previously-paid observation
  refunded // a supported source explicitly reports a refund of a previously-paid observation
  uncertain // a side effect may have occurred but cannot be proven
  conflict // contradictory authoritative observations, or an amount/currency/reference mismatch -- requires human review, never silently resolved
}

/// Distinguishes a real (future) connector-reported observation from this
/// story's own test/dev fixture-injection surface.
enum PaymentObservationSourceKind {
  fixture
  connector
}

// Distinguishes synthetic contract-fixture evidence from real Idealpos
// evidence at the DATA level, not just in test descriptions -- so any
// operator/audit surface can never mistake a fixture-driven row for a real
// Table 12 result. Shared vocabulary, not specific to any one dispatch
// implementation.
enum IdealposEvidenceTier {
  fixture_contract // produced by this repo's own fixture/contract test harness -- never reachable in production
  real_windows_table12 // produced by a real Windows connector talking to a real Idealpos instance during controlled pre-production testing
  real_production // produced by a real Windows connector during real venue operation
}

/// The current, projected payment-observation state for one order -- one
/// row per order, created lazily on the FIRST observation event (never
/// eagerly/via migration backfill: a missing row already means
/// `not_observed`). Mutated only via a database compare-and-set keyed on
/// `state` -- an out-of-order or contradictory observation can never
/// silently regress or overwrite a terminal state; it is redirected to
/// `conflict` instead, with the raw fact still preserved immutably in
/// PaymentObservationEvent.
model PaymentObservation {
  id      String                  @id @default(uuid())
  orderId String                  @unique
  venueId String
  state   PaymentObservationState @default(not_observed)

  // Immutable copy of the order's provisional payable total, captured the
  // first time this row is created -- this row's own history must never be
  // invalidated by anything else later touching Order's totals.
  provisionalPayableCents Int?

  // Only ever populated from a proven-authoritative observation event
  // (never any unverified figure -- see unverifiedAmountCents below for
  // where an unverified figure belongs).
  nativeReference   String?
  nativeAmountCents Int?
  nativeCurrency    String?
  tenderMethod      String?
  nativeTimestamp   DateTime?

  // Recorded ONLY for operator visibility -- never promoted to
  // nativeAmountCents/state=paid.
  unverifiedAmountCents  Int?
  unverifiedAmountSource String?

  discrepancyCents Int?
  // Free-text but from a closed, code-reviewed set maintained in
  // payment-observation.constants.ts (exact/mismatch/missing/unsupported/
  // currency_mismatch/pending) -- no DB enum, to match POSSyncRecord's own
  // closed-set-in-application convention.
  discrepancyState String @default("pending_authoritative_total")

  // CAS anchor: the observationId of whichever PaymentObservationEvent most
  // recently won the projection update. A duplicate delivery of the SAME
  // observationId is detected here and treated as a no-op, never reapplied.
  lastAppliedObservationId String?
  lastObservedAt           DateTime?

  reviewedAt        DateTime?
  reviewedByStaffId String?
  reviewNote        String? // sanitized only -- never a raw stack trace or secret

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order  @relation(fields: [orderId], references: [id])
  venue           Venue  @relation(fields: [venueId], references: [id])
  reviewedByStaff Staff? @relation(fields: [reviewedByStaffId], references: [id])

  // Database-enforced: one native payment reference can never silently
  // attach to two different orders (nulls are unrestricted, matching
  // Order.paymentProviderTransactionId's own established precedent for an
  // unrelated payment reference).
  @@unique([nativeReference])
  @@index([venueId, state, createdAt])
}

/// Append-only, immutable raw-fact ledger -- every observation ever
/// received, whether it won the CAS and became the current projection or
/// was rejected as stale/conflicting/a duplicate. Never updated or deleted
/// after insert. PaymentObservation above is only ever a PROJECTION of
/// these events.
model PaymentObservationEvent {
  id      String @id @default(uuid())
  orderId String
  venueId String

  // Caller-supplied idempotency key (a future connector's result/command id,
  // or this story's own fixture-injection call id) -- unique per order.
  observationId String

  schemaVersion Int
  sourceKind    PaymentObservationSourceKind
  // Sanitized adapter identity only (e.g. "api") -- never a raw Bridge
  // response or connector payload.
  adapterType   POSAdapterType?

  state           PaymentObservationState
  nativeReference String?
  amountCents     Int?
  currency        String?
  tenderMethod    String?
  nativeTimestamp DateTime?

  receivedAt   DateTime             @default(now())
  // fixture_contract is the only value any code path in this repository may
  // write today; the other values exist for a future real connector, never
  // fabricated here.
  evidenceTier IdealposEvidenceTier @default(fixture_contract)

  payloadFingerprint String? // SHA-256 of the canonicalized observation payload -- connector-local integrity/substitution guard
  handlerVersion     Int?
  sanitizedReason    String? // never a raw stack trace, SQL error, or credential

  // Written once, at insert time, by the same transaction that decided
  // whether this event won the PaymentObservation projection CAS.
  applied        Boolean @default(false)
  conflictReason String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([orderId, observationId])
  @@index([venueId, createdAt])
}

// Durable KDS delivery-intent outbox row. Order creation's own WebSocket push
// (OrdersService.broadcastOrder, post-commit, immediate) remains the fast
// path for an already-connected Kitchen Display; this row exists purely as a
// durability backstop for the crash window between that transaction commit
// and the post-commit emit — mirrors PrinterJob's/POSSyncRecord's outbox/CAS
// bookkeeping fields exactly, for consistency across all three delivery legs.
// One row per order (not per station): no KDS station/device model exists in
// this schema today, and the WebSocket room is one shared room per venue.
// Unlike PrinterJob/POSSyncRecord, this row is created unconditionally for
// every order, the same as OrderItem -- so it uses the same onDelete:
// Cascade as OrderItem rather than requiring every order-creating test file
// to learn a new required cleanup step.
model KdsDeliveryRecord {
  id      String            @id @default(uuid())
  orderId String            @unique
  venueId String
  status  KdsDeliveryStatus @default(queued)

  dispatchClaimId        String? // owner token for the current dispatch claim, if any
  dispatchClaimedAt      DateTime? // when the current dispatch claim was acquired
  dispatchClaimExpiresAt DateTime? // lease expiry; an expired claim is re-claimable
  pushedAt               DateTime?
  pushAttemptCount       Int       @default(0)
  lastDispatchError      String? // sanitized: push-attempt failure reason only, never a raw stack/secret
  dispatchExhaustedAt    DateTime? // set once pushAttemptCount exceeds the configured budget; requires manual staff verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id])

  @@index([status, dispatchExhaustedAt, createdAt])
}

model AuditLog {
  id             String    @id @default(uuid())
  organizationId String
  venueId        String?
  actorId        String
  actorEmail     String
  actorRole      StaffRole
  action         String
  resource       String
  resourceId     String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue?       @relation(fields: [venueId], references: [id])
  actor        Staff        @relation("ActorLogs", fields: [actorId], references: [id])
}

// ─── Story 2-9: Enterprise Venue Connector Identity ─────────────────────────
//
// Two-table enrollment-then-installation design, mirroring a standard
// OAuth-style "authorization code -> access credential" exchange:
//   ConnectorEnrollment — an admin-issued, short-lived, single-use bootstrap
//     code. Never a durable identity. Its hash is stored, never the
//     plaintext code (same convention as Staff.passwordHash).
//   ConnectorInstallation — the durable connector identity created when an
//     enrollment code is successfully redeemed. Its secret is stored
//     hashed (Argon2id, matching Staff.passwordHash) and the plaintext
//     secret is returned to the caller exactly once, at redemption time,
//     never persisted or re-returned afterward.
//
// This models CONNECTOR IDENTITY AND TRUST ONLY. It does not implement an
// outbound session/command protocol, a durable local queue, or command
// dispatch — those remain explicitly out of this story's scope (see the
// story file's "Deferred to a follow-on story" section).

model ConnectorEnrollment {
  id               String    @id @default(uuid())
  organizationId   String
  venueId          String
  // Argon2id hash of the plaintext bootstrap code. The plaintext is shown
  // to the administrator exactly once at creation time and is never
  // persisted anywhere, including logs or audit payloads.
  codeHash         String
  createdByStaffId String
  expiresAt        DateTime
  // Set atomically (in the same transaction as ConnectorInstallation
  // creation) the moment this code is successfully redeemed. A non-null
  // usedAt makes the code permanently unusable — this is the single-use
  // enforcement mechanism, checked via a guarded update, not an
  // application-level read-then-write.
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id])
  venue        Venue                  @relation(fields: [venueId], references: [id])
  createdBy    Staff                  @relation("ConnectorEnrollmentCreatedBy", fields: [createdByStaffId], references: [id])
  installation ConnectorInstallation?

  @@index([organizationId, venueId])
  @@index([expiresAt])
}

model ConnectorInstallation {
  id                       String                      @id @default(uuid())
  organizationId           String
  venueId                  String
  enrollmentId             String                      @unique
  // Argon2id hash of the durable connector secret. The plaintext is
  // returned exactly once, in the enrollment-redemption response, and is
  // never persisted, logged, or returned again — including to admin
  // read/list endpoints, which expose only metadata (id, status,
  // lastSeenAt, reportedVersion, etc.), never secretHash or any derivative
  // usable to reconstruct or brute-force the secret offline any faster
  // than attacking the hash itself would already allow.
  secretHash               String
  status                   ConnectorInstallationStatus @default(active)
  // Self-reported by the connector on successful authentication — never
  // trusted as evidence of Idealpos, EFTPOS, KDS, or printer connectivity.
  // Purely "this installation is alive and told us this about itself."
  reportedVersion          String?
  reportedCapabilities     Json?
  lastSeenAt               DateTime?
  revokedAt                DateTime?
  revokedByStaffId         String?
  // Set when this installation is superseded by a newer one via rotation —
  // preserves lineage (mirrors PrinterJob.reprintOfId's established
  // pattern) instead of silently losing the replacement relationship.
  replacedByInstallationId String?                     @unique
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id])
  venue           Venue                   @relation(fields: [venueId], references: [id])
  enrollment      ConnectorEnrollment     @relation(fields: [enrollmentId], references: [id])
  revokedBy       Staff?                  @relation("ConnectorInstallationRevokedBy", fields: [revokedByStaffId], references: [id])
  replacedBy      ConnectorInstallation?  @relation("ConnectorReplacement", fields: [replacedByInstallationId], references: [id])
  replacementOf   ConnectorInstallation[] @relation("ConnectorReplacement")
  claimedCommands ConnectorCommand[]

  // NOTE: the DB-enforced "at most one active installation per venue"
  // invariant cannot be expressed as a normal Prisma @@unique (it must be
  // a PARTIAL unique index, WHERE status = 'active') — added via raw SQL
  // in this model's migration, not expressible in this schema file. See
  // the migration.sql for the authoritative constraint.
  @@index([organizationId, venueId, status])
}

// ─── Story 15-1: Order Tablet device identity & staff elevation (DL-081) ────
//
// A deliberately separate domain from ConnectorEnrollment/ConnectorInstallation
// above — same proven security properties (Argon2id-hashed single-use
// enrollment code, Argon2id-hashed durable device secret, explicit
// revocation), adapted rather than shared, because an Order Tablet and a
// Venue Connector are different trust boundaries with different lifecycles
// (many tablets per venue is normal; a tablet is customer-facing, a
// connector never is). Unlike ConnectorInstallation, there is no
// "at most one active per venue" constraint here — multiple concurrently
// enrolled tablets per venue is the expected case.
model TabletEnrollment {
  id               String    @id @default(uuid())
  organizationId   String
  venueId          String
  // Argon2id hash of the plaintext one-time enrollment code. The plaintext
  // is shown to the administrator exactly once at creation time and is
  // never persisted anywhere, including logs or audit payloads.
  codeHash         String
  // Optional human-friendly label chosen at code-creation time (e.g.
  // "Patio tablet 3") — carried onto the resulting TabletDevice so an
  // enrolled device doesn't need a separate naming step.
  label            String?
  createdByStaffId String
  expiresAt        DateTime
  // Set atomically (in the same transaction as TabletDevice creation) the
  // moment this code is successfully redeemed — the single-use enforcement
  // mechanism, checked via a guarded update, not a read-then-write race.
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  venue        Venue         @relation(fields: [venueId], references: [id])
  createdBy    Staff         @relation("TabletEnrollmentCreatedBy", fields: [createdByStaffId], references: [id])
  device       TabletDevice?

  @@index([organizationId, venueId])
  @@index([expiresAt])
}

model TabletDevice {
  id               String             @id @default(uuid())
  organizationId   String
  venueId          String
  enrollmentId     String             @unique
  label            String
  // Argon2id hash of the durable device secret. The plaintext is returned
  // exactly once, in the enrollment-redemption response, and is never
  // persisted, logged, or returned again — including to admin read/list
  // endpoints, which expose only metadata (id, label, status, lastSeenAt),
  // never secretHash or any derivative.
  secretHash       String
  status           TabletDeviceStatus @default(active)
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  revokedByStaffId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  venue        Venue            @relation(fields: [venueId], references: [id])
  enrollment   TabletEnrollment @relation(fields: [enrollmentId], references: [id])
  revokedBy    Staff?           @relation("TabletDeviceRevokedBy", fields: [revokedByStaffId], references: [id])

  @@index([organizationId, venueId, status])
}

enum TabletDeviceStatus {
  active
  revoked
}

// ─── Story 2-10: Connector Command & Acceptance Protocol ────────────────────
//
// The durable, transport-agnostic command envelope + state machine that an
// authenticated Story 2-9 connector identity claims work against. This
// proves ONLY that an authenticated, venue-bound connector can durably
// accept responsibility for a command and truthfully report a terminal
// result — never that Idealpos, EFTPOS, KDS or a printer were contacted or
// succeeded. See connector-command.service.ts's class doc comment for the
// same boundary enforced in code.
model ConnectorCommand {
  id             String @id @default(uuid())
  organizationId String
  venueId        String

  // Versioned command contract. Exactly one commandType is implemented by
  // this story: 'connector.self_test.v1' — a synthetic, side-effect-free
  // echo used only to prove the protocol. A future story adds real command
  // types (e.g. an Idealpos-order-submit type) without changing this
  // envelope or its state machine.
  commandType   String
  schemaVersion Int    @default(1)

  // Points at the upstream business record that caused this command to
  // exist. Nullable because this story's own tracer command has no real
  // upstream business aggregate — it is admin-triggered, not
  // order/POS-driven, by design (see the story file's Explicit
  // Exclusions). A future real command type must set both fields (e.g.
  // sourceAggregateType: 'Order', sourceRecordId: <orderId>).
  sourceAggregateType String?
  sourceRecordId      String?

  // Caller-supplied, unique per (organizationId, venueId) — prevents a
  // retried creation call from creating two independent commands for the
  // same logical unit of work.
  idempotencyKey String

  correlationId String?
  causationId   String?

  // If set, only an installation whose self-reported reportedCapabilities
  // (Story 2-9 heartbeat) contains this key may claim the command.
  requiredCapability String?
  // Ceiling enforced in the service layer at creation time (see
  // MAX_PAYLOAD_BYTES) — never secrets, card data, or unnecessary customer
  // information (see the story file's Security Invariants).
  payload            Json

  status ConnectorCommandStatus @default(pending)

  createdByStaffId String?
  createdAt        DateTime @default(now())
  // A command not yet `accepted` by this time is never offered again.
  expiresAt        DateTime

  // ── Claim/lease bookkeeping — a lease on THIS row, not an internal-queue
  // dispatch marker (contrast with POSSyncRecord's dispatch* columns,
  // story 9-3, which mark handoff to an internal BullMQ queue, not a
  // connector claim) ──
  claimedByInstallationId String?
  claimedAt               DateTime?
  leaseExpiresAt          DateTime?
  claimAttemptCount       Int       @default(0)
  maxClaimAttempts        Int       @default(5)

  // ── Acceptance (CONNECTOR_ACCEPTED) ──
  acceptedAt             DateTime?
  // A command still `accepted` past this deadline with no terminal report
  // becomes `unknown` (reconciliation-required) via the sweep — never
  // auto-retried, since retrying an already-accepted command could
  // duplicate whatever a future real command type's side effect is.
  terminalReportDeadline DateTime?

  // ── Terminal report (connector-reported, truthful) ──
  resultType           String?
  resultPayload        Json?
  failureReason        String?
  reportedAt           DateTime?
  // The idempotency key the connector supplied on its terminal report
  // call. A byte-identical repeat (same key) is recognized as the same
  // report; a conflicting outcome/resultType for an already-terminal
  // command is rejected and audited, never silently overwritten.
  reportIdempotencyKey String?

  cancelledAt        DateTime?
  cancelledByStaffId String?

  updatedAt DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id])
  venue                 Venue                  @relation(fields: [venueId], references: [id])
  claimedByInstallation ConnectorInstallation? @relation(fields: [claimedByInstallationId], references: [id])
  createdByStaff        Staff?                 @relation("ConnectorCommandCreatedBy", fields: [createdByStaffId], references: [id])
  cancelledByStaff      Staff?                 @relation("ConnectorCommandCancelledBy", fields: [cancelledByStaffId], references: [id])
  // E8-S1 (expanded): back-relation for PrinterJob.connectorCommandId. At
  // most one PrinterJob points at a given command (enforced by the @unique
  // on PrinterJob.connectorCommandId) — full attempt history survives even
  // after a job's live pointer moves to a newer command, via
  // sourceAggregateType/sourceRecordId (queryable independently of this
  // back-relation).
  printerJob            PrinterJob?

  @@unique([organizationId, venueId, idempotencyKey])
  @@index([venueId, status, createdAt])
  @@index([status, expiresAt])
}

/// The durable half of the multi-round table-ordering model whose rules live
/// in `apps/api/src/orders/rounds/order-round.model.ts`. That module was
/// deliberately landed unused because the entities could not be migrated
/// until a native append mechanism was known. It now is: WPPacket
/// `<Order Type="Order2">` over TCP 6983, proven byte-exact against 42
/// genuine handheld packets.
///
/// WHY A ROUND IS ITS OWN ROW AND NOT A FLAG ON THE ORDER. A native handheld
/// sends DELTA rounds - the second Send to Kitchen on a table carries only
/// the new items, never the whole tab. That means "which lines belong to
/// which submission" is durable truth the kitchen depends on, not a view
/// derived from timestamps. `OrderItem.nativeRoundId` assigns each line to
/// exactly one round, and a line whose round is `confirmed` can never be
/// swept into a later one.
enum NativeRoundState {
  drafting
  submitting
  awaiting_native_confirmation
  confirmed
  rejected
  failed
  /// The send produced NO definite outcome. Never auto-retried, never auto
  /// -discarded, and the only state that requires a human to leave.
  unresolved
  /// A HUMAN walked to the till, looked at the table, and vouched that this
  /// round IS on it.
  ///
  /// DELIBERATELY NOT `confirmed`. `confirmed` means one thing only: the till
  /// was observed holding OUR attempt token against OUR DeviceID, which
  /// nothing but our own packet could have put there. A manager reading a
  /// table's bill sees items; they cannot tell "our round put these here"
  /// from "somebody keyed the same food while we were deciding" - which is
  /// precisely the correlated-vs-causal distinction the whole module is built
  /// to protect. Folding testimony into `confirmed` would make the strongest
  /// claim in the system unfalsifiable by making it unattributable.
  ///
  /// It is terminal and it is settled: the round is done, its lines stay
  /// claimed by it, and the table's in-flight slot is released so the next
  /// round can open. What it is NOT is proof of delivery, and no consumer may
  /// upgrade it to one.
  resolved_manually
  abandoned
}

model NativeTableRound {
  id      String @id @default(uuid())
  orderId String
  venueId String

  /// 1-based, contiguous, unique within the order. Derived from the highest
  /// sequence ever used, so an abandoned round never causes a reuse.
  sequence Int

  /// Minted when the round is OPENED, never at submit time. This is the fix
  /// for the restart hole: the key is durable before any submission is
  /// attempted, so every attempt for this round presents the same key.
  idempotencyKey String @unique

  state NativeRoundState @default(drafting)

  /// The client's own key for the Send press that opened this round.
  ///
  /// THE DOUBLE-TAP GUARD, AND IT HAS TO BE A CONSTRAINT RATHER THAN A CHECK.
  /// A waiter pressing Send twice in the same second produces two requests
  /// carrying the same key. Both would otherwise append their items to the
  /// order and open a round, and the second round would carry a second copy
  /// of the same food. `@unique` makes the second one lose at the database
  /// rather than at whichever read happened to run first: it fails with a
  /// unique violation, and the handler answers with the round the winner
  /// opened.
  ///
  /// Nullable because a round opened by anything other than an HTTP submit -
  /// a test, an operational tool - has no client request behind it, and
  /// Postgres does not consider two NULLs equal, so those rounds do not
  /// collide with each other.
  requestKey String? @unique

  /// The native IdealPOS table this round was built against, captured at
  /// OPEN time from `Table.posTableCode`. Stored on the round rather than
  /// read through the order at send time so that a later edit to the table's
  /// mapping cannot silently redirect an in-flight round to another table.
  posTableCode String
  guests       Int

  /// Set exactly once, on drafting -> submitting. Non-null means the line set
  /// is frozen and may no longer be edited under this identity.
  payloadFrozenAt DateTime?

  /// The native identity, once known. A round may NEVER be `confirmed` while
  /// `nativeSaleTier` is null or `correlated` - only a causal identity
  /// confirms, the same rule `confirmRound` enforces in the domain model.
  nativeSaleId     String?
  nativeSaleTier   String?
  nativeObservedAt DateTime?

  /// WHO TOOK RESPONSIBILITY, and for what. Written only by the manual
  /// resolution route, never by the reconciler.
  ///
  /// These exist because `resolved_manually` and a human-called `failed` are
  /// assertions by a named person rather than observations by a machine, and
  /// an assertion whose author is not recorded is a rumour. When a bill is
  /// disputed a week later, "the round was settled" is useless and "settled by
  /// this user at this time, who wrote that they saw three items on table 5"
  /// is answerable.
  ///
  /// All nullable: every round that existed before this migration, and every
  /// round the machine settles, has no human behind it and must not appear to.
  resolvedByUserId        String?
  /// The elevated staff identity behind a `tablet_manager` step-up, when the
  /// resolver reached this action through one. `JwtPayload.actingStaffId`
  /// exists so "a privileged action's audit trail can record both identities
  /// together", and settling a customer's bill by hand is that action. Null
  /// when the resolver was already a staff/manager session in their own right.
  resolvedByActingStaffId String?
  resolvedAt              DateTime?
  /// What the person said they saw. Required by the route, so a non-null
  /// `resolvedAt` always has one.
  resolutionBasis         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  attempts NativeSendAttempt[]

  @@unique([orderId, sequence])
  @@index([venueId, state])
  @@index([posTableCode, state])
}

/// One genuine submission attempt for one round, written BEFORE any byte can
/// leave the host.
///
/// THIS ROW EXISTING IS THE WHOLE POINT. If the process dies mid-send, the
/// next start must be able to tell "never sent" from "sent, outcome unknown"
/// - two states needing opposite handling. Without a row persisted ahead of
/// the socket there is no evidence a send was ever attempted, and the safe
/// reading of no evidence would have to be the dangerous one.
///
/// A SECOND ATTEMPT IS A SECOND ROW, never an update. The token is derived
/// from (roundId, attemptId), so a new attempt is a new token - required,
/// because the receiver would otherwise answer DUPLICATE to a genuinely new
/// submission. Nothing in the codebase creates an attempt automatically after
/// an ambiguous outcome; that is a human decision by design.
model NativeSendAttempt {
  id      String @id @default(uuid())
  roundId String

  /// Verdura's id for this attempt. Half the input to the duplicate token.
  attemptId String @unique

  /// The order id as the till will know it, carried so an attempt is
  /// self-describing without a join during incident review.
  externalOrderId String
  posTableCode    String

  /// Stable Verdura handheld identity. Never the venue iPad's, never
  /// "undefined" - see waiterpad-device-identity.ts.
  deviceId String

  /// The opaque equality token sent as `<Checksum>` and stored verbatim by
  /// the receiver at `AAAExampleData.ColumnType='IH-<deviceId>'`. Token
  /// equality against that row is the confirmation predicate.
  token String

  /// SHA-256 of the exact serialized payload. Stored instead of the payload
  /// so a later attempt can be proven identical or different without keeping
  /// a second copy of customer order content.
  payloadHash String

  sendInitiatedAt DateTime

  /// THE PRE-SEND BASELINE: the native table as it stood BEFORE this attempt's
  /// socket was opened, captured and committed in the same write as the rest of
  /// this row.
  ///
  /// WHY IT HAS TO BE DURABLE AND HAS TO BE HERE. Confirmation's durable half
  /// is a DELTA - the lines the table gained between this baseline and a later
  /// readback must equal exactly `expectedNativeItems`. A baseline held in
  /// process memory would be lost by the one event reconciliation exists to
  /// survive: a crash between the send and the answer. Written before the
  /// socket, it is available to a completely new instance reading these rows
  /// back, which is what lets a restart reconcile rather than escalate.
  ///
  /// Shape is `NativeTableSnapshot` from waiterpad-native-evidence.ts: a status
  /// plus, when observed, the table context and line multiset. A status of
  /// `unavailable` or `ambiguous` is stored honestly rather than as an absent
  /// baseline - "we looked and could not read it" is a different fact from "we
  /// never looked", and only the first one should stop a round from ever
  /// confirming.
  ///
  /// Null means no baseline was captured. That is a supported state - it is
  /// every row written before this column existed, and every send made with no
  /// reader bound - and it can never confirm. It never releases lines either.
  preSendTableSnapshot Json?

  /// What this attempt's packet actually asked the till to add, in native
  /// terms: `[{ nativeCode, quantity }]`.
  ///
  /// FROZEN WITH THE ATTEMPT, for the same reason `posTableCode` is frozen on
  /// the round. Deriving it later from the order's items and the venue's
  /// current PLU mapping would let an edit to that mapping change what a
  /// historical round is judged against, which would silently re-decide a
  /// round that has already been answered.
  expectedNativeItems Json?

  /// Null until the transport returns. `bytesLeftHost` is the safety-critical
  /// one, not `outcomeKind`: false ONLY where nothing can have been written.
  outcomeKind   String?
  bytesLeftHost Boolean?
  /// The licensed transition this outcome mapped to, e.g. confirmed /
  /// registrationRejected / uncertain / failedBeforeSend.
  decision      String?
  /// Sanitized receiver response text. Never a raw packet.
  responseNote  String?
  settledAt     DateTime?

  createdAt DateTime @default(now())

  round NativeTableRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, sendInitiatedAt])
  @@index([deviceId, sendInitiatedAt])
  @@index([token])
}

/// A financial obligation (Phase D5): what is owed for accepted order lines.
/// Not the order (requested goods), a kitchen ticket (production work), a
/// payment (money tendered, D6) or settlement (obligation satisfied, D6).
/// Created by Servvia Core from the orders' priced snapshots; clients name
/// orders or a table session, never amounts. No external-POS, payment
/// provider or reconciliation field belongs here.
///
/// A table session may have any number of checks (split bills later); an
/// order line is on at most one check that is not voided (CheckLine partial
/// unique index). Hand-written CHECKs in migration 20261002000000_checks:
/// version >= 1, key length 16..255, currency format, total = subtotal and
/// 0 <= tax, void fields set exactly when voided.
model Check {
  id                 String      @id @default(uuid())
  venueId            String
  /// The visit of the billed orders; null for orders without a table.
  tableSessionId     String?
  status             CheckStatus @default(open)
  /// ISO 4217 code, from the venue's tax configuration at creation.
  currency           String
  /// Sum of the line totals (gross), before discounts.
  subtotalCents      Int
  /// Phase D11: sum of the lines' discountCents, copied from the orders.
  discountCents      Int         @default(0)
  /// The GST contained in totalCents (D1 pricing).
  taxCents           Int
  /// What is owed: subtotalCents - discountCents (CHECK).
  totalCents         Int
  /// Optimistic concurrency: a change names the version it read.
  version            Int         @default(1)
  /// Client-generated key of the create request, unique per venue. A retry
  /// with the same request returns this check.
  idempotencyKey     String
  /// sha256 of the create request's canonical identity (venue plus session
  /// or order set), to tell a replay from a key reused for another request.
  requestFingerprint String
  createdByStaffId   String?
  voidedByStaffId    String?
  voidReason         String?
  voidedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  venue        Venue            @relation(fields: [venueId], references: [id])
  tableSession TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  createdBy    Staff?           @relation("CheckCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  voidedBy     Staff?           @relation("CheckVoidedBy", fields: [voidedByStaffId], references: [id], onDelete: SetNull)
  lines        CheckLine[]
  payments     CheckPayment[]
  settlement   CheckSettlement?

  @@unique([venueId, idempotencyKey])
  @@index([venueId, status])
  @@index([tableSessionId])
}

/// One billed order line (Phase D5): a copy of the order line's accepted
/// financial snapshot, never re-priced. voidedAt is set, in the same
/// transaction, when the check is voided; only lines with voidedAt NULL hold
/// the order line (partial unique index "CheckLine_orderItemId_standing_key").
model CheckLine {
  id             String    @id @default(uuid())
  checkId        String
  orderId        String
  orderItemId    String
  /// Position within the check, from 1.
  position       Int
  title          String
  quantity       Int
  /// Unit price including modifiers, as accepted on the order.
  unitPriceCents Int
  lineTotalCents Int
  /// Phase D11: the order line's accepted promotion discount, copied.
  discountCents  Int       @default(0)
  /// The order line's resolved modifiers, with their prices, as accepted.
  modifiers      Json      @default("[]")
  voidedAt       DateTime?

  check     Check     @relation(fields: [checkId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Composite key: a line's order is, by database constraint, the order of
  /// its order line.
  orderItem OrderItem @relation(fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)

  @@unique([checkId, position])
  @@index([orderItemId])
  @@index([orderId])
}

/// Lifecycle of a Check: open (the obligation stands), voided (created in
/// error and withdrawn; its lines may be billed again; never once money may
/// have moved), or settled (Phase D6: successful payments cover the total,
/// recorded by exactly one CheckSettlement, written in the same transaction).
enum CheckStatus {
  open
  voided
  settled
}

/// A tender against a check (Phase D6): money offered to pay the obligation.
/// Provider-neutral: no Stripe, EFTPOS, IdealPOS or observation state. A check
/// may have any number of payments (split tender, partial payment).
///
/// Staff initiate a payment (pending); only the trusted payment adapter
/// reports its result. pending -> succeeded | failed | uncertain, and
/// uncertain -> succeeded | failed (reconciliation). succeeded and failed are
/// final; a reversal will be its own record. Every change is a
/// CheckPaymentTransition. Rows are never deleted.
///
/// Amounts: a new payment must fit the check's available amount (total less
/// succeeded, pending and uncertain payments), checked under the check's row
/// lock, so concurrent tenders cannot overpay. Hand-written CHECKs in
/// migration 20261003000000_payments_settlement: amount > 0, version >= 1,
/// key length, currency format, resolvedAt set exactly when final.
model CheckPayment {
  id                 String             @id @default(uuid())
  venueId            String
  checkId            String
  amountCents        Int
  /// ISO 4217; always the check's currency.
  currency           String
  tenderType         TenderType
  status             CheckPaymentStatus @default(pending)
  version            Int                @default(1)
  /// Client-generated key of the initiate request, unique per venue: a retry
  /// after a lost response returns this payment, never a second tender.
  idempotencyKey     String
  /// sha256 of the request's identity (check, amount, currency, tender).
  requestFingerprint String
  requestedByStaffId String?
  /// Opaque reference reported by the adapter with a result (e.g. a terminal
  /// transaction id). Metadata for reconciliation, never an identity.
  resultReference    String?
  /// When the payment reached succeeded or failed.
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  venue                 Venue                       @relation(fields: [venueId], references: [id])
  check                 Check                       @relation(fields: [checkId], references: [id], onDelete: Restrict)
  requestedBy           Staff?                      @relation("CheckPaymentRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  transitions           CheckPaymentTransition[]
  settlement            CheckSettlement?
  cashMovement          CashMovement?
  adjustments           PaymentAdjustment[]
  settlementTransitions CheckSettlementTransition[]

  @@unique([venueId, idempotencyKey])
  @@index([checkId, status])
}

/// Payment history (Phase D6): creation and every status change, with the
/// actor. Not AuditLog: a payment adapter is not a Staff row.
model CheckPaymentTransition {
  id              String              @id @default(uuid())
  paymentId       String
  /// Null for the creation.
  fromStatus      CheckPaymentStatus?
  toStatus        CheckPaymentStatus
  /// 1, 2, ... per payment.
  sequence        Int
  /// A staff id, or the adapter identity (e.g. payment-adapter).
  actorId         String
  actorKind       String
  resultReference String?
  at              DateTime            @default(now())

  payment CheckPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, sequence])
}

/// The durable fact that a check's obligation was satisfied (Phase D6):
/// successful payments cover its total. Exactly one per check (unique
/// checkId), written in the same transaction as the payment success that
/// completed it, which also moves the check to settled. A future reversal
/// records its own revocation; this row is never deleted.
model CheckSettlement {
  id                String                      @id @default(uuid())
  checkId           String                      @unique
  amountCents       Int
  currency          String
  /// The payment whose success completed the obligation in the current (or
  /// last) cycle. Earlier cycles' settling payments are in the transitions.
  settlingPaymentId String                      @unique
  actorId           String
  actorKind         String
  settledAt         DateTime                    @default(now())
  /// Phase D9: the current settlement state. settled: the obligation is
  /// satisfied now. revoked: money was returned (refund or reversal) and the
  /// check owes again; a later success settles it again (cycle + 1). Every
  /// change is a CheckSettlementTransition; nothing is deleted.
  status            CheckSettlementStatus       @default(settled)
  cycle             Int                         @default(1)
  revokedAt         DateTime?
  version           Int                         @default(1)
  transitions       CheckSettlementTransition[]

  check           Check        @relation(fields: [checkId], references: [id], onDelete: Restrict)
  settlingPayment CheckPayment @relation(fields: [settlingPaymentId], references: [id], onDelete: Restrict)
}

/// Settlement history (Phase D9): every settled and revoked event of a
/// check's settlement, append-only. A settled event names the payment whose
/// success completed the obligation; a revoked event names the adjustment
/// (refund or reversal) whose success reopened it.
model CheckSettlementTransition {
  id           String                @id @default(uuid())
  settlementId String
  /// 1, 2, ... per settlement.
  sequence     Int
  toStatus     CheckSettlementStatus
  /// The settlement cycle the event belongs to.
  cycle        Int
  /// The check total the event concerns.
  amountCents  Int
  paymentId    String?
  adjustmentId String?
  actorId      String
  actorKind    String
  at           DateTime              @default(now())

  settlement CheckSettlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payment    CheckPayment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  adjustment PaymentAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  @@unique([settlementId, sequence])
}

/// Current state of a check's settlement.
enum CheckSettlementStatus {
  settled
  revoked
}

/// A return of money against one payment (Phase D9). Two kinds, one engine:
/// refund: requested by staff (card: pending until the payment adapter
/// reports; cash: handed back by staff under their open shift, succeeded at
/// once with a cash_refund movement). reversal: reported by the payment
/// adapter device when the provider reversed an earlier card tender;
/// succeeded at once. Provider-neutral; the result reference is metadata.
///
/// Capacity: succeeded, pending and uncertain adjustments together never
/// exceed their payment's amount (checked under the check, then payment,
/// row locks). A succeeded adjustment lowers the check's effective paid
/// amount and may revoke its settlement. Rows are never deleted. Hand-written
/// CHECKs in migration 20261006000000_refunds_reversals.
model PaymentAdjustment {
  id                 String                @id @default(uuid())
  venueId            String
  paymentId          String
  kind               PaymentAdjustmentKind
  amountCents        Int
  currency           String
  status             CheckPaymentStatus    @default(pending)
  version            Int                   @default(1)
  /// Client-generated key (staff refunds) or adapter-generated key
  /// (reversals), unique per venue: a retry returns this adjustment.
  idempotencyKey     String
  requestFingerprint String
  /// Why the money is returned (refunds).
  reason             String?
  requestedByStaffId String?
  /// The payment_adapter device that reported a reversal.
  originDeviceId     String?
  resultReference    String?
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  venue                 Venue                         @relation(fields: [venueId], references: [id])
  payment               CheckPayment                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy           Staff?                        @relation("PaymentAdjustmentRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: Restrict)
  originDevice          Device?                       @relation(fields: [originDeviceId], references: [id], onDelete: Restrict)
  transitions           PaymentAdjustmentTransition[]
  cashMovement          CashMovement?
  settlementTransitions CheckSettlementTransition[]

  @@unique([venueId, idempotencyKey])
  @@index([paymentId, status])
}

/// Adjustment history (Phase D9): creation and every status change.
model PaymentAdjustmentTransition {
  id              String              @id @default(uuid())
  adjustmentId    String
  fromStatus      CheckPaymentStatus?
  toStatus        CheckPaymentStatus
  sequence        Int
  actorId         String
  actorKind       String
  resultReference String?
  at              DateTime            @default(now())

  adjustment PaymentAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, sequence])
}

/// refund: requested by staff. reversal: reported by the payment adapter.
enum PaymentAdjustmentKind {
  refund
  reversal
}

/// Lifecycle of a CheckPayment. pending: initiated, awaiting its result.
/// succeeded / failed: definitive. uncertain: submitted but no reliable
/// result; never retried, never failed automatically, never settles, left
/// only by reconciliation.
enum CheckPaymentStatus {
  pending
  succeeded
  failed
  uncertain
}

/// How a payment is tendered. card: the result comes from the payment
/// adapter. cash (Phase D7): accepted by staff under their open Shift; it is
/// succeeded at once and recorded by exactly one CashMovement in the same
/// transaction.
enum TenderType {
  card
  cash
}

/// A bounded period of cash accountability (Phase D7): one staff member
/// responsible for the physical cash taken at one venue. Not a table session,
/// a check, a payment, a terminal or a drawer: no hardware identity exists
/// yet, and a terminal/drawer link is an additive column for the devices
/// phase. At most one open shift per (venue, staff), by a partial unique
/// index; several staff may have open shifts at a venue.
///
/// Expected cash = openingFloatCents + the shift's cash_sale movements,
/// computed by the server. At close the count, expected cash and variance
/// (count - expected) are stored and never change. Hand-written CHECKs in
/// migration 20261004000000_shifts_cash: non-negative float and count, close
/// fields set exactly when closed, variance = counted - expected, version >=
/// 1, key length, currency format.
model Shift {
  id                String      @id @default(uuid())
  venueId           String
  /// The staff member accountable for the shift's cash.
  staffId           String
  status            ShiftStatus @default(open)
  /// ISO 4217, from the venue at open.
  currency          String
  openingFloatCents Int
  /// Client-generated key of the open request, unique per venue: a retry
  /// returns this shift.
  openRequestKey    String
  version           Int         @default(1)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  closedByStaffId   String?
  countedCashCents  Int?
  expectedCashCents Int?
  varianceCents     Int?
  /// Phase D8: the POS terminal the shift is worked from, if any. Optional;
  /// shifts opened before D8 or without a terminal keep NULL. Accountability
  /// stays with the staff member (one open shift per venue and staff).
  terminalId        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  venue         Venue          @relation(fields: [venueId], references: [id])
  staff         Staff          @relation("ShiftStaff", fields: [staffId], references: [id], onDelete: Restrict)
  closedBy      Staff?         @relation("ShiftClosedBy", fields: [closedByStaffId], references: [id], onDelete: Restrict)
  /// Composite key: a shift's terminal is, by database constraint, a
  /// terminal of the shift's venue.
  terminal      Terminal?      @relation(fields: [terminalId, venueId], references: [id, venueId], onDelete: Restrict)
  cashMovements CashMovement[]

  @@unique([venueId, openRequestKey])
  @@index([venueId, status])
}

/// A durable change to a shift's accountable cash (Phase D7). Only
/// cash_sale today: a successful cash CheckPayment, exactly one movement per
/// payment (unique paymentId), written in the payment's transaction. Never
/// deleted; no client posts arbitrary entries.
model CashMovement {
  id           String           @id @default(uuid())
  venueId      String
  shiftId      String
  kind         CashMovementKind
  /// Always positive; the kind gives the direction (cash_sale: in,
  /// cash_refund: out).
  amountCents  Int
  /// The cash payment a cash_sale records (null for a cash_refund).
  paymentId    String?          @unique
  /// Phase D9: the cash refund a cash_refund records (null for a cash_sale).
  adjustmentId String?          @unique
  actorStaffId String
  createdAt    DateTime         @default(now())

  venue      Venue              @relation(fields: [venueId], references: [id])
  shift      Shift              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  payment    CheckPayment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  adjustment PaymentAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  actor      Staff              @relation("CashMovementActor", fields: [actorStaffId], references: [id], onDelete: Restrict)

  @@index([shiftId])
}

/// Lifecycle of a Shift: open, then closed (counted, with expected cash and
/// variance stored). Closed is final.
enum ShiftStatus {
  open
  closed
}

/// Kinds of cash movement. cash_sale: cash accepted as a check payment.
/// Paid-in/paid-out are added only when a workflow requires them.
enum CashMovementKind {
  cash_sale
  cash_refund
}

/// An enrolled installation that authenticates to Servvia (Phase D8): the
/// permanent device registry. kind says what the installation is, never who
/// may act: a device credential grants no staff role. Bound to one venue.
///
/// Credential: opaque `sdv1.<id>.<secret>` (32 random bytes). Only
/// sha256(secret) is stored; the plaintext is returned once, at enrollment
/// and rotation. Revocation is final and takes effect on the next request.
/// TabletDevice (Order Tablet) and the KDS PIN are transitional identities
/// this registry supersedes as those clients migrate.
///
/// Hand-written CHECKs in migration 20261005000000_devices_terminals:
/// display name 1..80 characters, credential hash format, version >= 1, key
/// length, revoked fields set exactly when revoked.
model Device {
  id                  String       @id @default(uuid())
  venueId             String
  kind                DeviceKind
  displayName         String
  status              DeviceStatus @default(active)
  /// sha256 of the credential secret, hex. Never returned by any API.
  credentialHash      String       @unique
  credentialRotatedAt DateTime?
  /// Client-generated key of the enrollment request, unique per venue.
  enrollRequestKey    String
  version             Int          @default(1)
  createdByStaffId    String
  revokedAt           DateTime?
  revokedByStaffId    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  venue              Venue               @relation(fields: [venueId], references: [id])
  createdBy          Staff               @relation("DeviceCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  revokedBy          Staff?              @relation("DeviceRevokedBy", fields: [revokedByStaffId], references: [id], onDelete: Restrict)
  /// At most one, by the unique Terminal.deviceId.
  terminals          Terminal[]
  /// Reversals this payment adapter reported.
  paymentAdjustments PaymentAdjustment[]

  @@unique([venueId, enrollRequestKey])
  /// Target of Terminal's composite foreign key (deviceId, deviceKind, venueId).
  @@unique([id, kind, venueId])
  @@index([venueId, kind, status])
}

/// A logical POS station at a venue (Phase D8), e.g. "Front Counter". Not
/// hardware. A venue has any number; the code is unique per venue. A terminal
/// may be bound to one pos_terminal Device of the same venue, and a device to
/// at most one terminal: composite foreign key (deviceId, deviceKind,
/// venueId) plus a CHECK that deviceKind is pos_terminal. A disabled
/// terminal cannot be chosen for a new shift; history is untouched.
model Terminal {
  id               String         @id @default(uuid())
  venueId          String
  name             String
  /// Short code, unique per venue, e.g. FRONT-1.
  code             String
  status           TerminalStatus @default(active)
  deviceId         String?        @unique
  /// Always pos_terminal when a device is bound (CHECK); part of the
  /// composite key that makes the database verify the device's kind.
  deviceKind       DeviceKind?
  createRequestKey String
  version          Int            @default(1)
  disabledAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  venue  Venue   @relation(fields: [venueId], references: [id])
  device Device? @relation(fields: [deviceId, deviceKind, venueId], references: [id, kind, venueId], onDelete: Restrict)
  shifts Shift[]

  @@unique([venueId, code])
  @@unique([venueId, createRequestKey])
  /// Target of Shift's composite foreign key (terminalId, venueId).
  @@unique([id, venueId])
}

/// What an installation is. Only kinds with a use today: kinds for waiter
/// tablets, kiosks, window displays and Venue Edge are added additively when
/// their phases need an identity.
enum DeviceKind {
  pos_terminal
  order_tablet
  kds
  payment_adapter
}

/// active: authenticates. revoked: never again (final).
enum DeviceStatus {
  active
  revoked
}

/// active: may be chosen for a new shift. disabled: not (final); past shifts
/// keep it.
enum TerminalStatus {
  active
  disabled
}

/// A promotion (Phase D11): a configured offer at ONE venue that staff may
/// apply when an order is created or a round submitted. Servvia Core decides
/// whether it is valid, which lines it covers and the discount; a client
/// never supplies an amount. What an order actually received is its
/// AppliedPromotion snapshot, never this row: editing or disabling a
/// promotion changes no accepted order.
///
/// Percentage only (the one type with product evidence). Targets: every
/// item, some categories, or some menu items, in typed columns (ids checked
/// against the organization when saved). Optional UTC window
/// [startsAt, endsAt). Never deleted: a promotion in use is restricted by
/// AppliedPromotion. Hand-written CHECKs in migration 20261007000000_promotions.
model Promotion {
  id                 String          @id @default(uuid())
  venueId            String
  name               String
  kind               PromotionKind
  /// Percentage in basis points, 1..10000 (1000 = 10 %).
  basisPoints        Int
  target             PromotionTarget
  /// Non-empty exactly when target = categories.
  categoryIds        String[]        @default([])
  /// Non-empty exactly when target = menu_items.
  menuItemIds        String[]        @default([])
  status             PromotionStatus @default(inactive)
  startsAt           DateTime?
  endsAt             DateTime?
  /// Optimistic concurrency: every change names the version it read, and an
  /// order applies the promotion only at the version it evaluated.
  version            Int             @default(1)
  /// Client-generated key of the create request, unique per venue.
  createRequestKey   String
  /// sha256 of the create request, to tell a replay from a key reuse.
  requestFingerprint String
  createdByStaffId   String
  updatedByStaffId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  venue        Venue              @relation(fields: [venueId], references: [id])
  createdBy    Staff              @relation("PromotionCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  updatedBy    Staff?             @relation("PromotionUpdatedBy", fields: [updatedByStaffId], references: [id], onDelete: Restrict)
  applications AppliedPromotion[]

  @@unique([venueId, createRequestKey])
  /// Target of AppliedPromotion's composite foreign key (promotionId, venueId).
  @@unique([id, venueId])
  @@index([venueId, status])
}

/// The financial effect of one promotion on one round (Phase D11), frozen
/// when the round was accepted: the promotion's identity, version and terms,
/// the eligible subtotal and the discount. At most one per round (no
/// stacking). The discounted lines point here, and each carries its share.
/// Composite keys make the database verify that the promotion is of the
/// order's venue and the round of the order.
model AppliedPromotion {
  id                    String          @id @default(uuid())
  venueId               String
  orderId               String
  roundId               String          @unique
  promotionId           String
  promotionVersion      Int
  name                  String
  kind                  PromotionKind
  basisPoints           Int
  target                PromotionTarget
  /// ISO 4217, the venue's at acceptance.
  currency              String
  eligibleSubtotalCents Int
  discountCents         Int
  appliedAt             DateTime        @default(now())

  order     Order       @relation(fields: [orderId, venueId], references: [id, venueId], onDelete: Cascade)
  round     OrderRound  @relation(fields: [roundId, orderId], references: [id, orderId], onDelete: Cascade)
  promotion Promotion   @relation(fields: [promotionId, venueId], references: [id, venueId], onDelete: Restrict)
  lines     OrderItem[]

  /// Target of OrderItem's composite foreign key (appliedPromotionId, orderId).
  @@unique([id, orderId])
  @@index([orderId])
  @@index([promotionId])
}

/// percentage: basisPoints of the eligible lines. Fixed amounts, codes,
/// bundles and the like are not supported (no requirement yet).
enum PromotionKind {
  percentage
}

/// inactive: configured but not applicable (the state at creation).
/// active: applicable within its window. Nothing is ever deleted.
enum PromotionStatus {
  inactive
  active
}

/// Which lines a promotion covers.
enum PromotionTarget {
  all_items
  categories
  menu_items
}
