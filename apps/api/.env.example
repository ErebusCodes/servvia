# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local development: point this at the project-local Postgres started via
# `npm run db:local:start` (see local-postgres/README.md). Match the
# user/password/port to whatever is in local-postgres/.env:
DATABASE_URL=postgresql://verdura:verdura_local_dev_only@127.0.0.1:5434/verdura_dev
#
# Windows and macOS use the same local connection. Docker-host mode overrides
# the hostname to `postgres` inside the Compose network.
#
# Use 127.0.0.1, not `localhost`: docker-compose.yml publishes Postgres bound
# to the IPv4 loopback only. On hosts where `localhost` resolves to `::1`
# (IPv6) first — Windows commonly does this — connecting via `localhost`
# fails with "Can't reach database server" even though the container is
# healthy. 127.0.0.1 is unambiguous on every platform.

# ── Media Storage ─────────────────────────────────────────────────────────────
# Used by MediaService for menu image uploads, served locally from disk —
# no external object-storage account required. All optional; sane defaults
# apply if unset.
# Directory (absolute or relative to the backend process cwd) where uploaded
# files are written. Defaults to ./storage. In Docker, point this at the
# mounted volume path (e.g. /app/storage).
MEDIA_STORAGE_PATH=storage
# Public origin used to build image URLs returned to clients, e.g.
# http://localhost:3000/media/menu/<uuid>.jpg. Defaults to
# http://localhost:${PORT}; set to your real public origin in production.
MEDIA_BASE_URL=http://localhost:3000
# Maximum accepted upload size in bytes. Defaults to 5 MiB.
MEDIA_MAX_FILE_SIZE_BYTES=5242880

# ── Google Cloud Storage — canonical media (2026-08-17) ─────────────────────
# See _bmad-output/implementation-artifacts/2026-08-17-gcs-media-architecture.md
# and docs/architecture.md's "Media storage" section for the full design.
# This is a SEPARATE system from MEDIA_STORAGE_PATH/MEDIA_BASE_URL above —
# that legacy path stays how the existing MenuManagementPage upload UI
# works today; GCS is the new MediaAsset upload/approval pipeline.
#
# Leave unset for local development — MEDIA_STORAGE_PROVIDER defaults to
# 'local', which needs no GCP credentials at all (uploads go through this
# same API process onto local disk). Production MUST set
# MEDIA_STORAGE_PROVIDER=gcs explicitly; the backend refuses to start with
# an incomplete GCS configuration in that case (fails closed, not silently
# falls back to local disk).
MEDIA_STORAGE_PROVIDER=local
# Required only when MEDIA_STORAGE_PROVIDER=gcs. Either name works —
# GOOGLE_CLOUD_PROJECT is what Cloud Run/GKE/Cloud Functions set
# automatically; GCP_PROJECT_ID is the explicit override for anywhere else.
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
# Required only when MEDIA_STORAGE_PROVIDER=gcs. Never a bucket also used
# for anything else — see the bucket-naming rationale in the architecture doc.
# This is the PRIVATE originals bucket — never anonymously readable.
GCS_MEDIA_BUCKET=
# Required only when MEDIA_STORAGE_PROVIDER=gcs. The separate, deliberately
# public-read bucket that the explicit "publish" transition copies an
# approved MediaAsset into. Must never be the same value as GCS_MEDIA_BUCKET
# above — see the media architecture doc's bucket-separation decision.
GCS_MEDIA_PUBLIC_BUCKET=
# Public base URL for the approved-delivery surface, if/when one exists
# (e.g. a Cloud CDN or load-balancer domain fronting public objects).
# Optional even with MEDIA_STORAGE_PROVIDER=gcs — private originals never
# use this; see GcsStorageProvider.
GCS_MEDIA_PUBLIC_BASE_URL=
# How long a signed upload/delivery URL stays valid, in seconds.
GCS_SIGNED_URL_TTL_SECONDS=900
#
# Never set here: a service-account JSON key, an OAuth token, or any other
# credential. GCS access uses Application Default Credentials only — run
# `gcloud auth application-default login` once per developer machine (GCS
# provider only; not needed for the 'local' default), or workload identity
# in a real deployment. See the architecture doc for exactly why.

# ── Redis (BullMQ + Socket.io adapter — E1-S4) ───────────────────────────────
# 127.0.0.1, not `localhost` — same IPv6-resolution pitfall as DATABASE_URL
# above; Redis is likewise published bound to the IPv4 loopback only.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Keep 0 when the backend is reached directly (the local-host default).
# Set to the exact number of trusted reverse-proxy hops only when applicable.
TRUST_PROXY_HOPS=0

# ── JWT (E2-S2) ───────────────────────────────────────────────────────────────
# Must be at least 32 characters (see app.module.ts configValidationSchema) —
# a shorter value fails Joi validation and the backend refuses to start.
JWT_ACCESS_SECRET=verdura-local-dev-only-access-secret-32chars-min
JWT_REFRESH_SECRET=verdura-local-dev-only-refresh-secret-32chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Seed (prisma/seed.ts) ──────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@verdura.co.nz
SEED_OWNER_PASSWORD=change-me-in-production
SEED_BILLING_EMAIL=admin@verdura.co.nz

# ── Service Token (E2-S9) ─────────────────────────────────────────────────────
# Internal service token for printer/pos integrations (min 32 characters)
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-32chars

# ── Stripe Terminal ───────────────────────────────────────────────────────────
# Required in production. Missing/invalid configuration fails closed; the API
# never fabricates a provider token or successful payment.
STRIPE_SECRET_KEY=

# ── KDS Device Auth (MVP-001) ─────────────────────────────────────────────────
# Venue-scoped PIN(s) for unattended kitchen-display terminals AND the Order
# Tablet's venue-unlock stage (both KdsAuthService and TabletAuthService read
# this same map — see their class doc comments). JSON map of venueId -> PIN.
# Leave blank to disable this auth entirely (the exchange/unlock endpoints
# then reject every request instead of accepting any PIN).
# Minimum length is 4 in production; a narrow, explicitly-tested
# development-only accommodation additionally permits the repository's
# canonical 3-character local-dev PIN ("108", matching ADMIN_CONSOLE_PIN
# below) whenever NODE_ENV is not "production" — see
# src/auth/validators/pin-length.validator.ts. Local development only;
# never a real credential.
#
# The key below is NOT a placeholder — it is LOCAL_VENUE_ID, the fixed local-
# development venue id from shared/local-dev.mjs (the same value already used
# verbatim by apps/admin-console/.env.example's VITE_VENUE_ID, and the id
# prisma/seed.ts always creates/enforces for the local "auckland" venue in
# non-production). A key here that doesn't exactly match the live database's
# venue id is the single most common cause of "PIN 108 doesn't work" — the
# lookup silently finds nothing and fails closed with a generic "Invalid PIN"
# that gives no hint why. `npm run dev` also validates this automatically
# (see scripts/dev.mjs's KDS_VENUE_PINS check) and fails startup with an
# actionable message if this ever drifts from the seeded venue id.
KDS_VENUE_PINS={"10000000-0000-4000-8000-000000000001":"108"}
# How long an issued KDS device token stays valid before the terminal must
# re-enter its PIN.
KDS_TOKEN_EXPIRY=12h

# ── Admin Operations Console PIN ──────────────────────────────────────────────────────
# Local-development values requested for this console. Set a different secret
# and an active owner/admin email in every deployed environment.
ADMIN_CONSOLE_PIN=108
ADMIN_CONSOLE_EMAIL=owner@verdura.co.nz

# ── Email — Resend (E5-S4) ────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank to disable email delivery (transitions still succeed)
# Resend Dashboard → API Keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Verdura Reservations <no-reply@verdura.co.nz>
EMAIL_BOOKINGS_BCC=bookings.verdura@gmail.com

# ── IdealPOS native handheld (WaiterPad Order2 over TCP 6983) ──────────────────
#
# THE WHOLE BLOCK IS OFF, AND IT STAYS OFF BY LEAVING IT ALONE. Every key below
# is either absent or empty in this file on purpose. With the block untouched
# the application binds DisabledTableRoundWriter, which refuses every round with
# ZERO socket activity - so a deploy that copies this file cannot send a packet
# to a till no matter what else is misconfigured.
#
# THERE IS NO PARTIAL ON. The configuration resolves all-or-nothing: if
# IDEALPOS_WAITERPAD_NATIVE_ENABLED is exactly "true" but ANY required key below
# is missing or invalid, the writer stays disabled and the API logs every reason
# at ERROR on boot. It does not fall back to the Webit path, and it does not
# start half-configured.
#
# BEFORE TURNING THIS ON, read docs/runbooks/native-waiterpad.md. There are
# live-only blockers that no configuration value resolves - a handheld licence
# seat on the certified machine among them.

# ── Which pipeline owns a dine-in order ──
# Unset (the default, and production today) means every dine-in order goes to
# the certified Webit/IdealposBridge path exactly as it always has. Set to
# "native_table_round" to route dine-in orders at this deployment through the
# native handheld path instead. This decides OWNERSHIP; it does not enable the
# writer, which needs the block below as well.
# IDEALPOS_POS_STRATEGY=

# ── The master switch ──
# Must be exactly the string "true". Anything else - "1", "TRUE", "yes", empty -
# leaves the writer disabled. Spelled strictly so that a truthy-looking value
# cannot switch on a route to a real till.
# IDEALPOS_WAITERPAD_NATIVE_ENABLED=

# ── Where the handheld receiver is ──
# The IdealPOS machine running the handheld server - Front / Machine 2 at the
# reference site, NOT Back / Machine 1. They are different boxes with different
# entitlements, and pointing this at the wrong one is the machine-attribution
# mistake the certification gate exists to prevent.
# IDEALPOS_WAITERPAD_HOST=
# The receiver's TCP port. Defaults to 6983 when unset.
# IDEALPOS_WAITERPAD_PORT=6983

# ── Verdura's handheld identity ──
# THE DEVICE ID IS A LICENCE SEAT, not a label. The till registers handhelds by
# this string and enforces a seat count; reusing a venue iPad's id, or sending
# the literal "undefined", puts Verdura's rounds under another device's identity
# and makes the till's own token row - the only confirming evidence on this
# protocol - unattributable. It must be a stable id issued to Verdura alone.
# IDEALPOS_WAITERPAD_DEVICE_ID=
# The IP the receiver should believe this client is at, as the handheld
# protocol carries it in the packet rather than reading it from the socket.
# IDEALPOS_WAITERPAD_LOCAL_ADDRESS=
# Client identification the receiver logs and, in places, branches on.
# IDEALPOS_WAITERPAD_CLIENT_VERSION=
# IDEALPOS_WAITERPAD_DEVICE_MODEL=
# IDEALPOS_WAITERPAD_DEVICE_OS=

# ── Who the till thinks is serving ──
# The POS terminal number and clerk number the round is booked against, plus
# the map and location the table code is resolved within. All four are
# IdealPOS-side identifiers and all four must come from the site's own
# configuration - there is no safe default and none is supplied.
# IDEALPOS_WAITERPAD_POS_TERMINAL=
# IDEALPOS_WAITERPAD_CLERK=
# IDEALPOS_WAITERPAD_MAP=
# IDEALPOS_WAITERPAD_LOCATION=

# ── Pricing ──
# "nativeResolved" lets the TILL price the round from its own PriceLevel, which
# is the only policy that can be correct: Verdura's menu price and IdealPOS's
# price for the same PLU are maintained separately, and sending ours would put
# a price on a customer's bill that the till does not agree with.
# IDEALPOS_WAITERPAD_PRICE_POLICY=nativeResolved
# WHICH price level, and it must be READ OFF THE SITE'S OWN CONFIGURATION.
# Guessing this is guessing what the customer is charged.
# IDEALPOS_WAITERPAD_PRICE_LEVEL=

# ── Seats ──
# Seat numbers above zero are refused unless this is exactly "true". Seat-level
# ordering has not been accepted live; leaving this unset sends every line at
# seat 0, which is the behaviour that has been exercised.
# IDEALPOS_WAITERPAD_ALLOW_NON_ZERO_SEAT=

# ── Transport timeouts, in milliseconds ──
# Each phase disarms its own deadline at its own boundary, so a value here
# bounds only the phase it names. All three are clamped to 250..60000.
# Connect. Default 5000.
# IDEALPOS_WAITERPAD_CONNECT_TIMEOUT_MS=5000
# Write. Default 5000. STILL USED - the transport arms it around the write and
# clears it when the last byte is flushed.
# IDEALPOS_WAITERPAD_WRITE_TIMEOUT_MS=5000
# Read. Default 10000. THE ONE WORTH THINKING ABOUT: a till that answers after
# this elapses produces an UNRESOLVED round, which blocks the table until a
# person settles it by hand. Too short is not a safe failure here, it is a
# table taken out of service.
# IDEALPOS_WAITERPAD_READ_TIMEOUT_MS=10000

# ── The certification gate (separate from everything above) ──
# Names the certified MACHINE, not a venue and not a boolean - the handheld
# entitlement belongs to a specific box. Unset, empty or malformed is off.
# IDEALPOS_WAITERPAD_CERTIFIED=

# ── Reconciliation and crash recovery ──
#
# ONE FLAG ARMS BOTH SWEEPS, and it is deliberately NOT implied by
# IDEALPOS_WAITERPAD_NATIVE_ENABLED. Sending rounds and running unattended
# timers over them are separate decisions, and a deployment that turned on the
# writer should not silently acquire two background sweeps it did not ask for.
# Must be exactly "true". Unset means neither timer starts and no round is
# escalated or recovered automatically.
# IDEALPOS_NATIVE_RECONCILE_ENABLED=

# How often reconciliation looks at unproven rounds. Default 30000.
# IDEALPOS_NATIVE_RECONCILE_INTERVAL_MS=30000
# How many rounds one tick examines. Default 50.
# IDEALPOS_NATIVE_RECONCILE_BATCH_SIZE=50
# HOW LONG A ROUND MAY GO UNPROVEN BEFORE A HUMAN IS ASKED. Default 300000
# (5 minutes). When it elapses the round becomes `unresolved`, the tablet turns
# red, and the table is blocked until a manager settles it by hand - so this is
# the patience of the kitchen, not a technical timeout. Too short manufactures
# manual resolutions; too long leaves a waiter believing a round is on its way.
# IDEALPOS_NATIVE_RECONCILE_ESCALATE_AFTER_MS=300000

# How often the crash-recovery sweep runs. Default 60000.
# IDEALPOS_NATIVE_RECOVERY_INTERVAL_MS=60000
# How many rounds one recovery tick examines. Default 50.
# IDEALPOS_NATIVE_RECOVERY_BATCH_SIZE=50
# HOW OLD A MID-SEND ROUND MUST BE BEFORE RECOVERY WILL JUDGE IT. Default
# 300000 (5 minutes). This is the safety margin against judging a round that a
# LIVE process is still sending: a sweep that acted too early could release the
# lines of a send that is in flight this instant. Raise it if in doubt.
# IDEALPOS_NATIVE_RECOVERY_MIN_AGE_MS=300000

# ─────────────────────────────────────────────────────────────────────────
# AUTOMATIC CONFIRMATION — the capability that turns a sent round green.
#
# A round that cannot be machine-confirmed does not fail. It waits out the
# escalation window above, becomes `unresolved`, and holds its table's single
# in-flight slot until a human settles it — for every round of every service.
# So these are not optional extras to the native writer; the writer REFUSES TO
# START without them. See waiterpad-activation-invariant.ts.
#
# Confirming a round needs BOTH halves of a proof, and neither is sufficient:
#
#   CAUSAL   the till holds OUR attempt token against OUR DeviceID in
#            AAAExampleData. Only our packet could have put it there, which is
#            what rules out "a waiter keyed the same items while we decided".
#            It does NOT prove a line exists: IPS.exe writes that token BEFORE
#            it writes any sale line.
#
#   DURABLE  the table's line multiset AFTER the round, minus a baseline
#            captured BEFORE the socket opened, equals exactly this round's
#            items. A line COUNT will not do - a tab already carrying five
#            lines would "prove" a two-line round that never arrived.
#
# WHICH EVIDENCE READER TO BIND. Only "connector" exists: it mediates both
# reads through the Venue Connector, which is the component co-located with
# the till and already trusted with its credentials. The API never holds a
# till credential. Unset means no reader, which is a supported configuration
# and the default - the reconciler then only escalates. A TYPO IS A REFUSAL,
# never a silent fallback to none.
# IDEALPOS_NATIVE_EVIDENCE_READER=

# WHERE THE "BEFORE" OF THE DELTA COMES FROM. Only "connector" exists. This is
# a THIRD requirement and is not redundant with the reader: a reader and a
# sweep can see the table as it is NOW, and with nothing to subtract, the
# delta cannot be computed at all. A build with a reader, a sweep and no
# baseline source is exactly as unable to confirm as one with neither - and
# looks far more configured.
# IDEALPOS_NATIVE_BASELINE_SOURCE=

# THE DELIBERATELY AWKWARD ESCAPE HATCH, for a staging build that runs the
# native writer while knowingly unable to confirm anything. It must be the
# exact sentence `every-round-needs-a-human` - a boolean would be set by
# muscle memory and forgotten, a sentence describing the consequence has to be
# read. It warns on EVERY start and leaves the build marked NOT ready for live
# activation. It must never take a live service.
# IDEALPOS_WAITERPAD_ACCEPT_NO_CONFIRMATION=

# How long a connector evidence probe's answer stays current. Default 60000.
# NATIVE_ROUND_EVIDENCE_RESULT_FRESHNESS_MS=60000
# Maximum probes ever created for ONE attempt. Default 60.
# NATIVE_ROUND_EVIDENCE_MAX_PROBES=60
# Stop probing once an attempt has been outstanding this long. Default
# 21600000 (6 hours).
# NATIVE_ROUND_EVIDENCE_PROBE_WINDOW_MS=21600000

# ─────────────────────────────────────────────────────────────────────────
# CONNECTOR-SIDE READ-ONLY DATABASE ACCESS — set on the VENUE CONNECTOR, not
# here. Listed in this file only so the whole picture is in one place; putting
# a till connection string in the API's environment would defeat the reason
# the readback is connector-mediated.
#
# Both default to UNSET, and every failure keeps the fail-closed stand-ins. The
# SQL login must hold read access ONLY (e.g. db_datareader). That is an
# OPERATIONAL requirement satisfied by whoever creates the login - the
# connector cannot check it, and does not claim to.
#
#   IDEALPOS_POSSERVER_CONNECTION_STRING   the table readback (PendingSales /
#                                          PendingSaleLines) - the DURABLE half
#   IDEALPOS_POSSERVER_MAP                 venue configuration, never assumed
#   IDEALPOS_POSSERVER_POS                 venue configuration, never assumed
#   IDEALPOS_HANDHELD_TOKEN_CONNECTION_STRING
#                                          the AAAExampleData token row - the
#                                          CAUSAL half
#
# The token connection is a SEPARATE variable from the POSServer one on
# purpose. Which database holds AAAExampleData is INFERENCE, not proof: the
# ingress capture shows it updated alongside POSServer tables, which is
# suggestive and not conclusive. An operator who has confirmed they are the
# same database can set both to the same value; an operator who has not is
# never silently committed to a guess. A wrong database yields "unavailable"
# on every read, which costs confirmations and cannot cost correctness.

# ── The evidence reader ──
# NOT A CONFIGURATION VALUE. `NATIVE_ROUND_EVIDENCE_READER` is a Nest injection
# token, and no connector build binds one - reading the till's token row needs a
# capability no connector advertises today. Leaving it unbound is a SUPPORTED
# state and is what every build does: reconciliation reports readerBound false,
# confirms nothing, and still escalates rounds that have gone unproven, which is
# the half of its job that does not need till access. There is no environment
# variable that turns this on and setting one would do nothing.
