# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local development: point this at the project-local Postgres started via
# `npm run db:local:start` (see local-postgres/README.md). Match the
# user/password/port to whatever is in local-postgres/.env:
DATABASE_URL=postgresql://verdura:verdura_local_dev_only@127.0.0.1:5434/verdura_dev
#
# Windows and macOS use the same local connection. Docker-host mode overrides
# the hostname to `postgres` inside the Compose network.
#
# Use 127.0.0.1, not `localhost`: docker-compose.yml publishes Postgres bound
# to the IPv4 loopback only. On hosts where `localhost` resolves to `::1`
# (IPv6) first — Windows commonly does this — connecting via `localhost`
# fails with "Can't reach database server" even though the container is
# healthy. 127.0.0.1 is unambiguous on every platform.

# ── Media Storage ─────────────────────────────────────────────────────────────
# Used by MediaService for menu image uploads, served locally from disk —
# no external object-storage account required. All optional; sane defaults
# apply if unset.
# Directory (absolute or relative to the backend process cwd) where uploaded
# files are written. Defaults to ./storage. In Docker, point this at the
# mounted volume path (e.g. /app/storage).
MEDIA_STORAGE_PATH=storage
# Public origin used to build image URLs returned to clients, e.g.
# http://localhost:3000/media/menu/<uuid>.jpg. Defaults to
# http://localhost:${PORT}; set to your real public origin in production.
MEDIA_BASE_URL=http://localhost:3000
# Maximum accepted upload size in bytes. Defaults to 5 MiB.
MEDIA_MAX_FILE_SIZE_BYTES=5242880

# ── Google Cloud Storage — canonical media (2026-08-17) ─────────────────────
# See _bmad-output/implementation-artifacts/2026-08-17-gcs-media-architecture.md
# and docs/architecture.md's "Media storage" section for the full design.
# This is a SEPARATE system from MEDIA_STORAGE_PATH/MEDIA_BASE_URL above —
# that legacy path stays how the existing MenuManagementPage upload UI
# works today; GCS is the new MediaAsset upload/approval pipeline.
#
# Leave unset for local development — MEDIA_STORAGE_PROVIDER defaults to
# 'local', which needs no GCP credentials at all (uploads go through this
# same API process onto local disk). Production MUST set
# MEDIA_STORAGE_PROVIDER=gcs explicitly; the backend refuses to start with
# an incomplete GCS configuration in that case (fails closed, not silently
# falls back to local disk).
MEDIA_STORAGE_PROVIDER=local
# Required only when MEDIA_STORAGE_PROVIDER=gcs. Either name works —
# GOOGLE_CLOUD_PROJECT is what Cloud Run/GKE/Cloud Functions set
# automatically; GCP_PROJECT_ID is the explicit override for anywhere else.
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
# Required only when MEDIA_STORAGE_PROVIDER=gcs. Never a bucket also used
# for anything else — see the bucket-naming rationale in the architecture doc.
# This is the PRIVATE originals bucket — never anonymously readable.
GCS_MEDIA_BUCKET=
# Required only when MEDIA_STORAGE_PROVIDER=gcs. The separate, deliberately
# public-read bucket that the explicit "publish" transition copies an
# approved MediaAsset into. Must never be the same value as GCS_MEDIA_BUCKET
# above — see the media architecture doc's bucket-separation decision.
GCS_MEDIA_PUBLIC_BUCKET=
# Public base URL for the approved-delivery surface, if/when one exists
# (e.g. a Cloud CDN or load-balancer domain fronting public objects).
# Optional even with MEDIA_STORAGE_PROVIDER=gcs — private originals never
# use this; see GcsStorageProvider.
GCS_MEDIA_PUBLIC_BASE_URL=
# How long a signed upload/delivery URL stays valid, in seconds.
GCS_SIGNED_URL_TTL_SECONDS=900
#
# Never set here: a service-account JSON key, an OAuth token, or any other
# credential. GCS access uses Application Default Credentials only — run
# `gcloud auth application-default login` once per developer machine (GCS
# provider only; not needed for the 'local' default), or workload identity
# in a real deployment. See the architecture doc for exactly why.

# ── Redis (BullMQ + Socket.io adapter — E1-S4) ───────────────────────────────
# 127.0.0.1, not `localhost` — same IPv6-resolution pitfall as DATABASE_URL
# above; Redis is likewise published bound to the IPv4 loopback only.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Keep 0 when the backend is reached directly (the local-host default).
# Set to the exact number of trusted reverse-proxy hops only when applicable.
TRUST_PROXY_HOPS=0

# ── JWT (E2-S2) ───────────────────────────────────────────────────────────────
# Must be at least 32 characters (see app.module.ts configValidationSchema) —
# a shorter value fails Joi validation and the backend refuses to start.
JWT_ACCESS_SECRET=verdura-local-dev-only-access-secret-32chars-min
JWT_REFRESH_SECRET=verdura-local-dev-only-refresh-secret-32chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Seed (prisma/seed.ts) ──────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@verdura.co.nz
SEED_OWNER_PASSWORD=change-me-in-production
SEED_BILLING_EMAIL=admin@verdura.co.nz

# ── Service Token (E2-S9) ─────────────────────────────────────────────────────
# Internal service token for printer/pos integrations (min 32 characters)
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-32chars

# ── Stripe Terminal ───────────────────────────────────────────────────────────
# Required in production. Missing/invalid configuration fails closed; the API
# never fabricates a provider token or successful payment.
STRIPE_SECRET_KEY=

# ── KDS Device Auth (MVP-001) ─────────────────────────────────────────────────
# Venue-scoped PIN(s) for unattended kitchen-display terminals, per
# docs/ux.md "PIN entry on first load — no full staff login". JSON map of
# venueId -> PIN. Leave blank to disable KDS device auth entirely (the
# exchange endpoint then rejects every request instead of accepting any PIN).
# Minimum length is 4 in production; a narrow, explicitly-tested
# development-only accommodation additionally permits the repository's
# canonical 3-character local-dev PIN ("108", matching ADMIN_CONSOLE_PIN
# below) whenever NODE_ENV is not "production" — see
# src/auth/validators/pin-length.validator.ts. Local development only;
# never a real credential.
KDS_VENUE_PINS={"<venue-uuid>":"108"}
# How long an issued KDS device token stays valid before the terminal must
# re-enter its PIN.
KDS_TOKEN_EXPIRY=12h

# ── Admin Operations Console PIN ──────────────────────────────────────────────────────
# Local-development values requested for this console. Set a different secret
# and an active owner/admin email in every deployed environment.
ADMIN_CONSOLE_PIN=108
ADMIN_CONSOLE_EMAIL=owner@verdura.co.nz

# ── Email — Resend (E5-S4) ────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank to disable email delivery (transitions still succeed)
# Resend Dashboard → API Keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Verdura Reservations <no-reply@verdura.co.nz>
EMAIL_BOOKINGS_BCC=bookings.verdura@gmail.com
