<?xml version="1.0" encoding="utf-8"?>
<!--
  Sanitized sample — no real secrets. Copy to the install directory as
  App.config and fill in every CHANGE_ME below before starting the bridge.
  The bridge refuses to start (fail-closed, see Config/BridgeConfig.cs)
  with any of these left as a placeholder.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!--
      Point at the DISPOSABLE TEST SQL Server only. Never the live
      restaurant's production Idealpos database for this preflight/first
      experiment. Trusted_Connection=True means the Windows account
      running this process IS the SQL Server login — see
      install-locations.md and README.md "Which Windows account".
    -->
    <add name="IpsConnection"
         connectionString="Server=CHANGE_ME_DISPOSABLE_TEST_SQL_SERVER\IDEALSQL;Database=IPSTransaction;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Loopback only for the first controlled test. Do not set AllowLan
         until this bridge is proven and a real security review of the
         LAN-facing deployment has happened. -->
    <add key="Bridge:BindAddress" value="127.0.0.1" />
    <add key="Bridge:Port" value="5588" />
    <add key="Bridge:AllowLan" value="false" />

    <!-- REQUIRED. Generate a fresh secret specific to this test — e.g. in
         PowerShell: [guid]::NewGuid().ToString() -->
    <add key="Bridge:ApiKey" value="CHANGE_ME_GENERATE_A_FRESH_GUID" />

    <!-- No browser client involved in the controlled test — leave blank. -->
    <add key="Bridge:CorsAllowedOrigins" value="" />

    <add key="Idealpos:DllProbeDirectory" value="" />
    <!-- Adjust to the real IPS.exe path on the target machine if you want
         the extra existence sanity-check in /api/health — optional, the
         actual "is Idealpos running" check is by process name regardless. -->
    <add key="Idealpos:ExpectedIpsExePath" value="CHANGE_ME_OR_LEAVE_BLANK" />

    <add key="Idealpos:PollingIntervalSeconds" value="5" />
    <add key="Idealpos:OrderStaleTimeoutMinutes" value="15" />

    <!-- REQUIRED. See docs/table12-preflight/table-assignment-review.md
         before picking a value — this is genuinely unproven until tomorrow's
         experiment. One of: NoHint, DeliverTo, Message, ReferencePrefix,
         HostReference. -->
    <add key="Idealpos:TableAssignmentStrategy" value="CHANGE_ME" />
    <add key="Idealpos:TableAssignmentConfirmed" value="false" />

    <!-- Point these at C:\ProgramData\Verdura\IdealposBridge\... — see
         install-locations.md. -->
    <add key="Bridge:StateDatabasePath" value="C:\ProgramData\Verdura\IdealposBridge\state\bridge-state.sqlite" />
    <add key="Logging:Directory" value="C:\ProgramData\Verdura\IdealposBridge\logs" />
    <add key="Logging:MinLevel" value="Info" />
  </appSettings>
</configuration>
