<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    ============================================================
    SAFETY: same pattern as VerduraIdealposHarness's App.config.
    This placeholder will not resolve, so the bridge fails loudly
    at startup instead of silently reusing IdealPos.Webit.Core.dll's
    own hardcoded default (Server=localhost\IDEALSQL;Database=IPSTransaction;
    Trusted_Connection=True;) â€” which would also match a live
    production POS Server. Point this at your disposable test
    instance first; only repoint at production once every test in
    README.md "Testing" has passed AND the table-assignment
    strategy below has been confirmed there.
    ============================================================
  -->
  <connectionStrings>
    <add name="IpsConnection" connectionString="Server=localhost\IDEALSQL;Database=IPSTransaction;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- ==================== HTTP bind ==================== -->
    <!-- Default is loopback-only. See "AllowLan" before changing. -->
    <add key="Bridge:BindAddress" value="127.0.0.1" />
    <add key="Bridge:Port" value="5588" />
    <!--
      Must be explicitly set to "true" for BindAddress values other than
      127.0.0.1/localhost to take effect. This is a second, deliberate gate
      on top of BindAddress itself, so a LAN-facing bind can't happen by
      editing one line without also affirming the security implication.
      If Verdura tablets call this bridge directly over LAN, also open the
      configured port in Windows Firewall â€” see README.md "Security".
    -->
    <add key="Bridge:AllowLan" value="false" />
    <!--
      Required. No default â€” the bridge refuses to start without a real key.
      Generate one yourself (e.g. a GUID) and keep this file out of source
      control / restrict its NTFS permissions. Verdura sends it as:
        Authorization: Bearer <this value>
      on every request, including the WebSocket upgrade.
    -->
    <add key="Bridge:ApiKey" value="CHANGE_ME_GENERATE_A_FRESH_GUID" />
    <!-- Comma-separated origins allowed to call this API from a browser
         context (Verdura's own tablet web app origin(s)). Leave blank to
         disable CORS entirely (same-origin/non-browser clients only). -->
    <add key="Bridge:CorsAllowedOrigins" value="" />
    <!-- ==================== Idealpos integration ==================== -->
    <!-- Fallback probing directory for the Idealpos DLLs if they are not
         sitting next to VerduraIdealposBridge.exe at run time. Leave blank
         to rely on standard .NET Framework probing (same folder as the
         .exe) only. -->
    <add key="Idealpos:DllProbeDirectory" value="" />
    <!-- Used only for an existence sanity-check in /api/health; the actual
         "is IPS.exe running" check is by process name (Process.GetProcessesByName("IPS")),
         which works regardless of this path. -->
    <add key="Idealpos:ExpectedIpsExePath" value="C:\Idealpos\IPS.exe" />
    <!-- How often the background watcher re-checks WebPendingOrder /
         PendingSales / PendingSaleLines for orders it is still tracking. -->
    <add key="Idealpos:PollingIntervalSeconds" value="5" />
    <!-- How long the watcher keeps polling a single order before giving up
         and marking it "uncertain" (2026-08-19: was "failed" â€” corrected,
         since a timeout never proves Idealpos did not or will not process
         the order; see README.md "Order lifecycle"). -->
    <add key="Idealpos:OrderStaleTimeoutMinutes" value="15" />
    <!--
      REQUIRED, no default, on purpose. Per the investigation's Section K.2,
      no field on WebOrder is confirmed to control table assignment on
      order creation â€” VerduraIdealposHarness exists to determine that
      experimentally. Pick the strategy that harness testing supports and
      set it here explicitly; the bridge refuses to start with an unset or
      unrecognized value rather than silently defaulting to an unproven
      guess. Recognized values: NoHint, DeliverTo, Message, ReferencePrefix,
      HostReference. See TableAssignment/Strategies.cs.
    -->
    <add key="Idealpos:TableAssignmentStrategy" value="NoHint" />
    <!-- Flip to "true" only after VerduraIdealposHarness has demonstrated,
         on this Idealpos version, that the configured strategy above
         actually results in PendingSales.Code equalling the requested
         table. Purely a labelling flag â€” it changes how /api/health and
         order status responses describe confidence, never the strategy's
         behaviour itself. -->
    <add key="Idealpos:TableAssignmentConfirmed" value="false" />
    <!-- ==================== Local state store ==================== -->
    <!-- SQLite file tracking externalOrderId idempotency + lifecycle state.
         Relative paths are resolved against the bridge's own base directory. -->
    <add key="Bridge:StateDatabasePath" value="state\bridge-state.sqlite" />
    <!-- ==================== Logging ==================== -->
    <add key="Logging:Directory" value="logs" />
    <!-- One of: Debug, Info, Warn, Error -->
    <add key="Logging:MinLevel" value="Info" />
  </appSettings>
</configuration>