<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    ============================================================
    SAFETY: this connection string is intentionally NOT usable
    as shipped. "localhost" will not resolve, so the
    harness fails loudly on connect instead of silently reusing
    IdealPos.Webit.Core.dll's own hardcoded fallback
    (Server=localhost\IDEALSQL;Database=IPSTransaction;Trusted_Connection=True;)
    — which is exactly the string a LIVE production POS Server
    machine would also satisfy if this harness were ever run
    there. You must edit the line below to point at a disposable
    test SQL Server instance restored from
    Idealpos/TemplateDatabases/ipstransactionnew.zip's database.bak
    (see README.md) before "insert" will run.

    Do NOT point this at the live restaurant's POS Server.
    ============================================================
  -->
  <connectionStrings>
    <add name="IpsConnection"
         connectionString="Server=localhost\IDEALSQL;Database=IPSTransaction;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
