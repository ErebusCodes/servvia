# Base URL of the Verdura API.
# The Vite dev proxy (/api → localhost:3000, see vite.config.js) is the
# recommended dev setup. Leave this unset (empty) to use it.
VITE_API_URL=

# The venue UUID whose live menu (and, in future phases, reservations) the
# customer site displays. Find it via the admin panel or GET /api/venues
# (staff-authenticated) — for local dev, whatever apps/api/prisma/seed.ts
# seeded (see local-postgres/README.md).
VITE_VENUE_ID=10000000-0000-4000-8000-000000000001
