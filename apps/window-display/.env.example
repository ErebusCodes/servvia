# Base URL of the Verdura API.
# IMPORTANT: The Vite dev proxy (/api → localhost:3000) is the recommended
# dev setup. Leave this unset (empty) to use the Vite proxy.
VITE_API_URL=

# The venue UUID this kiosk is configured for.
# Find the venue ID via the admin panel or GET /api/venues.
VITE_VENUE_ID=10000000-0000-4000-8000-000000000001
