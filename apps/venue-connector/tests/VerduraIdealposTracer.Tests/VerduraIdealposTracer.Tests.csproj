<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>VerduraIdealposTracer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VerduraIdealposTracer.Core\VerduraIdealposTracer.Core.csproj" />
    <ProjectReference Include="..\..\src\VerduraIdealposTracer.Fixtures\VerduraIdealposTracer.Fixtures.csproj" />

    <!--
      CrashReplayTests spawns DryRunCli as a REAL separate OS process and
      reads its build output off disk, so it needs that output to exist in
      the SAME configuration the tests were built in. ReferenceOutputAssembly
      is false because nothing here compiles against DryRunCli — this
      reference exists purely to make `dotnet build`/`dotnet test` on THIS
      project also produce the executable the crash proof spawns.

      Without it the retry/crash no-resend proof fails with "DryRunCli build
      output not found ... run `dotnet build` on the solution first" — and on
      an SDK 8 machine that instruction is impossible to follow, because
      VerduraIdealposTracer.slnx needs SDK 9.0.200+ to build. The crash proof
      must never depend on a remembered manual step.
    -->
    <ProjectReference Include="..\..\src\VerduraIdealposTracer.DryRunCli\VerduraIdealposTracer.DryRunCli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
