<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Story 9-2: cross-platform on purpose (net8.0, no -windows suffix) — it
    never references System.Windows.Automation. It drives the real
    DiscoveryTracerService against a fake, clearly-labelled
    IIdealposUiAutomationClient (never a real Idealpos), so it:
      1. Lets an operator validate the connector-protocol/local-persistence
         plumbing on the target Windows machine BEFORE attempting real
         Idealpos discovery (the operator runbook's "dry run" step).
      2. Lets this story prove real crash/replay behaviour as a real,
         separate OS process — the same rigor Story 2-10's own harness
         used — on any platform, including the one this story was
         implemented on. See docs/operator-runbook.md and this story's Dev
         Agent Record for how this evidence is scoped and labelled.
    This project's own successful run is UNIT_OR_MOCK / dry-run evidence.
    It is never REAL_WINDOWS_CONNECTOR or REAL_IDEALPOS_UI_DISCOVERY
    evidence, and must never be described as such.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VerduraIdealposTracer.DryRunCli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VerduraIdealposTracer.Core\VerduraIdealposTracer.Core.csproj" />
    <ProjectReference Include="..\VerduraIdealposTracer.Fixtures\VerduraIdealposTracer.Fixtures.csproj" />
  </ItemGroup>

</Project>
