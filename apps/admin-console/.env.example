# Base URL of the Verdura API.
# IMPORTANT: The Vite dev proxy (/api → localhost:3000) is the recommended
# dev setup. If you bypass it by setting this to http://localhost:3000,
# the browser will suppress the refresh_token cookie on POST /api/auth/refresh
# due to SameSite=Strict cross-origin enforcement, permanently breaking
# silent session restore. Leave this unset (empty) to use the Vite proxy.
VITE_API_URL=

# The venue UUID Orders/KDS/Order Tablet operate against (shared/orders.ts
# DEFAULT_VENUE_ID). Must match a real seeded Venue.id, not a placeholder —
# left unset, Admin/KDS/Tablet will silently query a nonexistent venue and
# show zero orders forever. Find it via the admin panel or GET /api/venues.
VITE_VENUE_ID=10000000-0000-4000-8000-000000000001
