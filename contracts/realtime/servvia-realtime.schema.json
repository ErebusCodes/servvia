    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "occurredAt",
        "organizationId",
        "venueId",
        "aggregateType",
        "aggregateId",
        "version",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique per event; the same fact redelivered has the same eventId (deduplicate by it)."
        },
        "eventType": {
          "enum": [
            "check.created",
            "check.settled",
            "check.settlement_revoked",
            "check.voided",
            "kitchen_ticket.created",
            "kitchen_ticket.transitioned",
            "order.created",
            "order.round_submitted",
            "payment.created",
            "payment.status_changed",
            "promotion.activated",
            "promotion.created",
            "promotion.disabled",
            "promotion.updated",
            "refund.created",
            "refund.status_changed",
            "reversal.recorded",
            "shift.closed",
            "shift.opened",
            "table_session.cancelled",
            "table_session.closed",
            "table_session.opened"
          ]
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "Server time of the transaction that made the change."
        },
        "organizationId": {
          "type": "string",
          "minLength": 1
        },
        "venueId": {
          "type": "string",
          "minLength": 1
        },
        "aggregateType": {
          "enum": [
            "check",
            "kitchen_ticket",
            "order",
            "payment",
            "promotion",
            "refund",
            "reversal",
            "shift",
            "table_session"
          ]
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "The aggregate's version after the change; null for an aggregate without one (order). Monotonic per aggregate: drop an event older than what you hold."
        },
        "payload": {
          "type": "object",
          "description": "Identifiers, statuses and summary amounts only. Refetch the resource over HTTP for detail."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "check.created"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "check"
              },
              "payload": {
                "$ref": "#/$defs/payload.check.created"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "check.settled"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "check"
              },
              "payload": {
                "$ref": "#/$defs/payload.check.settled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "check.settlement_revoked"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "check"
              },
              "payload": {
                "$ref": "#/$defs/payload.check.settlement_revoked"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "check.voided"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "check"
              },
              "payload": {
                "$ref": "#/$defs/payload.check.voided"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "kitchen_ticket.created"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "kitchen_ticket"
              },
              "payload": {
                "$ref": "#/$defs/payload.kitchen_ticket.created"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "kitchen_ticket.transitioned"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "kitchen_ticket"
              },
              "payload": {
                "$ref": "#/$defs/payload.kitchen_ticket.transitioned"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "order.created"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "order"
              },
