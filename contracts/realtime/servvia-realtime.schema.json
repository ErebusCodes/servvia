        },
        "tableSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "const": "open"
        },
        "settlementId": {
          "type": "string",
          "minLength": 1
        },
        "cycle": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "payload.check.voided": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "tableSessionId",
        "status"
      ],
      "properties": {
