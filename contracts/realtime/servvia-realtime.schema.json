        },
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "station": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "enum": [
            "new",
            "acknowledged",
            "preparing",
            "ready",
            "completed",
            "recalled"
          ]
        },
        "to": {
          "type": "string",
          "enum": [
            "new",
            "acknowledged",
            "preparing",
            "ready",
            "completed",
            "recalled"
          ]
        }
      }
    },
    "payload.order.created": {
