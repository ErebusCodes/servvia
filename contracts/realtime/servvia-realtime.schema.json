              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "order.round_submitted"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "order"
              },
              "payload": {
                "$ref": "#/$defs/payload.order.round_submitted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "payment.created"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "payment"
              },
              "payload": {
                "$ref": "#/$defs/payload.payment.created"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "payment.status_changed"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "payment"
              },
              "payload": {
                "$ref": "#/$defs/payload.payment.status_changed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "promotion.activated"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "promotion"
              },
              "payload": {
                "$ref": "#/$defs/payload.promotion.activated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "promotion.created"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "promotion"
              },
              "payload": {
                "$ref": "#/$defs/payload.promotion.created"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "promotion.disabled"
              }
            }
          },
          "then": {
            "properties": {
              "aggregateType": {
                "const": "promotion"
              },
              "payload": {
                "$ref": "#/$defs/payload.promotion.disabled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "promotion.updated"
              }
