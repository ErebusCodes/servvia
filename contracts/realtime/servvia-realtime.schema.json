    "payload.table_session.opened": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableSessionId",
        "tableId",
        "tableNumber",
        "status",
        "covers"
      ],
      "properties": {
        "tableSessionId": {
          "type": "string",
          "minLength": 1
        },
        "tableId": {
          "type": "string",
          "minLength": 1
        },
        "tableNumber": {
          "type": "string",
          "minLength": 1
